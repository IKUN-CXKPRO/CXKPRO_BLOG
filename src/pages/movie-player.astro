---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
---

<MainGridLayout title="简易播放器" description="">
  <div class="onload-animation space-y-6">
    <section class="card-base rounded-[var(--radius-large)] p-8">
        <div class="flex items-center gap-4">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-[var(--primary)] rounded-2xl">
            <Icon name="material-symbols:movie" class="text-white text-3xl" />
          </div>
          <div>
            <h1 class="text-3xl font-bold text-white">简易播放器</h1>
      <p class="text-75 text-white/80 mt-2">😱99% AI编写😱</p>
          </div>
        </div>
    </section>

    <section class="card-base rounded-[var(--radius-large)] p-6 space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg p-4">
          <div class="text-sm font-medium text-white mb-2">本地播放（推荐）</div>
          <div class="flex items-center gap-3">
            <button id="local-pick" type="button" class="px-3 py-2 text-xs font-medium text-white bg-[var(--primary)] rounded-lg hover:opacity-90 transition">选择本地文件</button>
            <span id="local-name" class="text-xs text-white/70 truncate">未选择</span>
          </div>
          <input id="local-file" type="file" accept=".mkv,.mp4,.webm,.m4v,.mov,.avi,.ts,.m2ts" class="hidden" />
          <div class="text-xs text-white/60 mt-2">支持 MKV/MP4/WebM/MOV/AVI/TS/M2TS。读取本地文件不会上传。</div>
        </div>

        <div class="bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg p-4">
          <div class="text-sm font-medium text-white mb-2 flex items-center gap-2">
            URL 播放
            <span class="text-[10px] px-2 py-0.5 rounded-full border border-[var(--line-divider)] text-white/70">实验性</span>
          </div>
          <input id="video-url" class="mt-2 w-full px-3 py-2 bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg text-white text-sm placeholder:text-white/40" placeholder="https://example.com/video.mkv" />
          <div class="text-xs text-white/60 mt-2">跨域与编码限制可能导致无法播放。</div>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <button id="load-btn" class="px-4 py-2 text-sm font-medium text-white bg-[var(--primary)] rounded-lg hover:opacity-90 transition">加载并播放</button>
        <button id="stop-btn" class="px-4 py-2 text-sm font-medium text-90 bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg hover:border-[var(--primary)] transition">停止</button>
      </div>

      <div class="text-xs text-white/60">提示：浏览器对 MKV 支持有限，若无法播放请检查视频编码或使用 MP4/HLS。</div>
    </section>

    <section class="card-base rounded-[var(--radius-large)] p-6">
      <h2 class="text-xl font-bold text-white mb-4 flex items-center">
        <Icon name="material-symbols:play-circle" class="mr-2 text-[var(--primary)]" />
        播放器
      </h2>
      <video id="player" class="w-full rounded-lg border border-[var(--line-divider)] bg-black" controls playsinline preload="metadata"></video>

      <div class="mt-4 bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg p-4">
        <div class="text-sm font-medium text-white mb-2">视频信息</div>
        <div id="video-info" class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs text-white/80"></div>
      </div>

      <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg p-4">
          <div class="text-sm font-medium text-white mb-2">字幕</div>
          <div class="flex items-center gap-3 flex-wrap">
            <select id="subtitle-select" class="px-2 py-1 text-sm bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg text-white"></select>
            <label class="text-xs text-white/60">大小</label>
            <input id="subtitle-size" type="range" min="16" max="48" value="24" />
          </div>
        </div>
        <div class="bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg p-4">
          <div class="text-sm font-medium text-white mb-2">音轨</div>
          <div class="flex items-center gap-3 flex-wrap">
            <select id="audio-select" class="px-2 py-1 text-sm bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg text-white"></select>
            <button id="audio-refresh" class="px-3 py-1 text-xs border border-[var(--line-divider)] rounded-lg hover:border-[var(--primary)] transition text-white">刷新</button>
          </div>
          <div class="text-xs text-white/60 mt-2">说明：audioTracks 在部分浏览器不可用。</div>
        </div>
      </div>
    </section>

    <section class="card-base rounded-[var(--radius-large)] p-6">
      <h2 class="text-xl font-bold text-white mb-4 flex items-center">
        <Icon name="material-symbols:bug-report" class="mr-2 text-[var(--primary)]" />
        播放信息
      </h2>
      <div id="ui-debug" class="grid grid-cols-1 md:grid-cols-3 gap-3 text-sm text-white"></div>
    </section>

    <section class="card-base rounded-[var(--radius-large)] p-6">
      <h2 class="text-xl font-bold text-white mb-4 flex items-center">
        <Icon name="material-symbols:terminal" class="mr-2 text-[var(--primary)]" />
        调试输出（简版）
      </h2>
      <div id="log-box" class="bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg p-4 text-xs font-mono whitespace-pre-wrap break-words max-h-[260px] overflow-y-auto text-white"></div>
    </section>
  </div>

    <div id="backend-modal" class="fixed inset-0 hidden items-center justify-center bg-black/70 z-[1000]">
      <div class="bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-[var(--radius-large)] p-6 max-w-lg w-[90%]">
        <h3 class="text-lg font-bold text-white mb-2">需要后端转换</h3>
        <p class="text-sm text-white/80 leading-6">
          当前文件需要后端解复用/转码才能播放。上传后将进行服务器转换。如果你担心数据泄露，请离开。
        </p>
        <div class="mt-4 flex items-center gap-3 justify-end">
          <button id="modal-cancel" class="px-3 py-1.5 text-xs border border-[var(--line-divider)] rounded-lg text-white/80 hover:border-[var(--primary)] transition">取消</button>
          <button id="modal-confirm" class="px-3 py-1.5 text-xs bg-[var(--primary)] rounded-lg text-white hover:opacity-90 transition">继续上传</button>
        </div>
      </div>
    </div>

  <style>
    #log-box div { margin-bottom: 6px; }
    #ui-debug .info-card {
      border: 1px solid var(--line-divider);
      border-radius: 10px;
      padding: 10px;
      background: var(--card-bg);
    }
    #ui-debug .info-title { font-size: 12px; color: rgba(255, 255, 255, 0.6); }
    #ui-debug .info-value { font-size: 13px; color: #ffffff; margin-top: 4px; word-break: break-word; }
    #video-info .info-chip {
      border: 1px solid var(--line-divider);
      border-radius: 10px;
      padding: 8px;
      background: var(--card-bg);
    }
    #video-info .info-label { color: rgba(255,255,255,0.6); }
    #video-info .info-value { color: #ffffff; margin-top: 4px; word-break: break-word; }
  </style>

  <script is:inline>
    const player = document.getElementById('player');
    const urlInput = document.getElementById('video-url');
    const loadBtn = document.getElementById('load-btn');
    const stopBtn = document.getElementById('stop-btn');
    const localFile = document.getElementById('local-file');
    const localPick = document.getElementById('local-pick');
    const localName = document.getElementById('local-name');
    const subtitleSelect = document.getElementById('subtitle-select');
    const subtitleSize = document.getElementById('subtitle-size');
    const audioSelect = document.getElementById('audio-select');
    const audioRefresh = document.getElementById('audio-refresh');
    const logBox = document.getElementById('log-box');
    const uiDebug = document.getElementById('ui-debug');
    const videoInfo = document.getElementById('video-info');
    const backendModal = document.getElementById('backend-modal');
    const modalCancel = document.getElementById('modal-cancel');
    const modalConfirm = document.getElementById('modal-confirm');
    let pendingIsoFile = null;

    let HlsLib = null;
    let hls = null;
    const uiCards = {
      state: createInfoCard('状态'),
      media: createInfoCard('媒体'),
      buffer: createInfoCard('缓冲'),
      track: createInfoCard('轨道')
    };

    function createInfoCard(title) {
      const card = document.createElement('div');
      card.className = 'info-card';
      const t = document.createElement('div');
      t.className = 'info-title';
      t.textContent = title;
      const v = document.createElement('div');
      v.className = 'info-value';
      v.textContent = '-';
      card.appendChild(t);
      card.appendChild(v);
      uiDebug.appendChild(card);
      return v;
    }

    let currentSourceMeta = { type: 'unknown', size: '未知', name: '未选择', source: '未知' };

    function log(msg, data) {
      const time = new Date().toLocaleTimeString();
      const line = document.createElement('div');
      line.textContent = `[${time}] ${msg}`;
      logBox.appendChild(line);
      logBox.scrollTop = logBox.scrollHeight;
      if (data !== undefined) {
        console.debug(`[movie-player] ${msg}`, data);
      } else {
        console.debug(`[movie-player] ${msg}`);
      }
    }

    function updateUi() {
      const state = [
        `readyState=${player.readyState}`,
        `networkState=${player.networkState}`,
        `paused=${player.paused}`,
        `ended=${player.ended}`
      ].join(' | ');

      const media = [
        `currentTime=${player.currentTime.toFixed(2)}`,
        `duration=${isFinite(player.duration) ? player.duration.toFixed(2) : 'NaN'}`,
        `size=${player.videoWidth}x${player.videoHeight}`
      ].join(' | ');

      let bufferText = '-';
      if (player.buffered && player.buffered.length) {
        const last = player.buffered.length - 1;
        bufferText = `${player.buffered.start(0).toFixed(2)} - ${player.buffered.end(last).toFixed(2)}`;
      }

      const trackText = [
        `textTracks=${player.textTracks?.length || 0}`,
        `audioTracks=${player.audioTracks?.length || 0}`
      ].join(' | ');

      uiCards.state.textContent = state;
      uiCards.media.textContent = media;
      uiCards.buffer.textContent = bufferText;
      uiCards.track.textContent = trackText;
    }

    function setVideoInfo(items) {
      videoInfo.innerHTML = '';
      items.forEach((item) => {
        const chip = document.createElement('div');
        chip.className = 'info-chip';
        const label = document.createElement('div');
        label.className = 'info-label';
        label.textContent = item.label;
        const value = document.createElement('div');
        value.className = 'info-value';
        value.textContent = item.value;
        chip.appendChild(label);
        chip.appendChild(value);
        videoInfo.appendChild(chip);
      });
    }

    function formatSize(bytes) {
      if (!bytes && bytes !== 0) return '未知';
      if (bytes < 1024) return `${bytes} B`;
      const kb = bytes / 1024;
      if (kb < 1024) return `${kb.toFixed(2)} KB`;
      const mb = kb / 1024;
      if (mb < 1024) return `${mb.toFixed(2)} MB`;
      const gb = mb / 1024;
      return `${gb.toFixed(2)} GB`;
    }

    function extFromName(name) {
      const clean = name.split('?')[0].split('#')[0];
      const parts = clean.split('.');
      if (parts.length < 2) return '未知';
      return parts[parts.length - 1].toLowerCase();
    }

    function showBackendModal() {
      backendModal.classList.remove('hidden');
      backendModal.classList.add('flex');
    }

    function hideBackendModal() {
      backendModal.classList.add('hidden');
      backendModal.classList.remove('flex');
    }

    function needsBackendByName(name) {
      const lower = name.toLowerCase();
      return lower.endsWith('.iso') || lower.endsWith('.bdmv');
    }

    async function uploadIsoAndPlay(file) {
      if (!file) return;
      log('开始上传 ISO', { name: file.name, size: file.size });
      updateUiStatus('上传中...');
      const form = new FormData();
      form.append('file', file);
      try {
        const res = await fetch('/api/iso-demux', { method: 'POST', body: form });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          log('后端转换失败', data);
          updateUiStatus('转换失败');
          return;
        }
        log('后端转换完成', data);
        updateUiStatus('转换完成，开始播放');
        currentSourceMeta = {
          type: 'hls',
          size: formatSize(file.size),
          name: file.name,
          source: '后端转换'
        };
        attachSource(data.hls);
        player.load();
        player.play().catch((e) => log('播放失败', e));
      } catch (e) {
        log('上传/转换异常', e);
        updateUiStatus('转换异常');
      }
    }

    function refreshSubtitleList() {
      subtitleSelect.innerHTML = '';
      const none = document.createElement('option');
      none.value = 'off';
      none.textContent = '关闭';
      subtitleSelect.appendChild(none);

      if (hls && hls.subtitleTracks && hls.subtitleTracks.length) {
        hls.subtitleTracks.forEach((t, i) => {
          const opt = document.createElement('option');
          opt.value = String(i);
          opt.textContent = t.name || t.lang || `字幕 ${i + 1}`;
          subtitleSelect.appendChild(opt);
        });
        return;
      }

      const tracks = player.textTracks || [];
      for (let i = 0; i < tracks.length; i += 1) {
        const opt = document.createElement('option');
        opt.value = String(i);
        opt.textContent = tracks[i].label || `字幕 ${i + 1}`;
        subtitleSelect.appendChild(opt);
      }
    }

    function refreshAudioList() {
      audioSelect.innerHTML = '';
      if (hls && hls.audioTracks && hls.audioTracks.length) {
        hls.audioTracks.forEach((t, i) => {
          const opt = document.createElement('option');
          opt.value = String(i);
          opt.textContent = t.name || t.lang || `音轨 ${i + 1}`;
          audioSelect.appendChild(opt);
        });
        return;
      }
      if (!player.audioTracks || !player.audioTracks.length) {
        const opt = document.createElement('option');
        opt.value = 'na';
        opt.textContent = '未检测到音轨';
        audioSelect.appendChild(opt);
        return;
      }

      for (let i = 0; i < player.audioTracks.length; i += 1) {
        const track = player.audioTracks[i];
        const opt = document.createElement('option');
        opt.value = String(i);
        opt.textContent = track.label || `音轨 ${i + 1}`;
        audioSelect.appendChild(opt);
      }
    }

    function setSubtitleSize(px) {
      let styleTag = document.getElementById('subtitle-style');
      if (!styleTag) {
        styleTag = document.createElement('style');
        styleTag.id = 'subtitle-style';
        document.head.appendChild(styleTag);
      }
      styleTag.textContent = `video::cue { font-size: ${px}px; }`;
    }

    function destroyHls() {
      if (hls) {
        hls.destroy();
        hls = null;
      }
    }

    function attachSource(url) {
      destroyHls();
      if (url.endsWith(".m3u8") && HlsLib && HlsLib.isSupported()) {
        hls = new HlsLib({ enableWorker: true, debug: true });
        hls.loadSource(url);
        hls.attachMedia(player);
        hls.on(HlsLib.Events.MANIFEST_PARSED, () => {
          log("HLS 清单解析完成");
          refreshAudioList();
          refreshSubtitleList();
        });
        hls.on(HlsLib.Events.ERROR, (event, data) => {
          log("HLS 错误", data);
        });
      } else {
        player.src = url;
      }
    }

    function setSource(url) {
      player.pause();
      player.removeAttribute('src');
      player.load();
      if (!url) {
        log('未提供 URL');
        return;
      }
      if (needsBackendByName(url)) {
        showBackendModal();
        pendingIsoFile = null;
        log('需要后端转换（URL）', { url });
        return;
      }
      const ext = extFromName(url);
      currentSourceMeta = { type: ext, size: '未知', name: url, source: 'URL' };
      attachSource(url);
      player.load();
      player.play().catch((e) => log('播放失败', e));
      log('加载视频', { url });
    }

    function setLocalFile(file) {
      player.pause();
      player.removeAttribute('src');
      player.load();
      if (!file) {
        log('未选择本地文件');
        return;
      }
      if (needsBackendByName(file.name)) {
        showBackendModal();
        pendingIsoFile = file;
        log('需要后端转换（本地文件）', { name: file.name, type: file.type, size: file.size });
        return;
      }
      currentSourceMeta = {
        type: file.name ? extFromName(file.name) : '未知',
        size: formatSize(file.size),
        name: file.name || '未命名',
        source: '本地文件'
      };
      const objectUrl = URL.createObjectURL(file);
      attachSource(objectUrl);
      player.load();
      player.play().catch((e) => log('播放失败', e));
      log('加载本地文件', { name: file.name, type: file.type, size: file.size });
      player.addEventListener('ended', () => URL.revokeObjectURL(objectUrl), { once: true });
    }

    const events = [
      'loadstart', 'loadedmetadata', 'loadeddata', 'canplay', 'canplaythrough',
      'play', 'pause', 'waiting', 'stalled', 'seeking', 'seeked', 'ended',
      'timeupdate', 'error', 'durationchange', 'ratechange', 'volumechange'
    ];

    events.forEach((evt) => {
      player.addEventListener(evt, () => {
        if (evt === 'error') {
          log(`事件: ${evt}`, player.error);
        } else if (evt === 'loadedmetadata') {
          refreshSubtitleList();
          refreshAudioList();
          log(`事件: ${evt}`, { duration: player.duration, size: `${player.videoWidth}x${player.videoHeight}` });
          const supportInfo = [
            `mkv=${player.canPlayType('video/x-matroska') || 'no'}`,
            `mp4=${player.canPlayType('video/mp4') || 'no'}`,
            `webm=${player.canPlayType('video/webm') || 'no'}`
          ].join(' | ');
          setVideoInfo([
            { label: '来源', value: currentSourceMeta.source },
            { label: '名称', value: currentSourceMeta.name },
            { label: '类型', value: currentSourceMeta.type },
            { label: '大小', value: currentSourceMeta.size },
            { label: '尺寸', value: `${player.videoWidth}x${player.videoHeight}` },
            { label: '时长', value: isFinite(player.duration) ? `${player.duration.toFixed(2)}s` : '未知' },
            { label: '字幕轨', value: `${player.textTracks?.length || 0}` },
            { label: '音轨', value: `${player.audioTracks?.length || 0}` },
            { label: '浏览器支持', value: supportInfo }
          ]);
        } else {
          log(`事件: ${evt}`);
        }
      });
    });

    loadBtn.addEventListener('click', () => {
      setSource(urlInput.value.trim());
    });

    localFile.addEventListener('change', () => {
      const file = localFile.files && localFile.files[0];
      localName.textContent = file ? file.name : '未选择';
      setLocalFile(file);
    });

    localPick.addEventListener('click', () => {
      localFile.click();
    });

    stopBtn.addEventListener('click', () => {
      player.pause();
      player.removeAttribute('src');
      player.load();
      currentSourceMeta = { type: '未知', size: '未知', name: '未选择', source: '未知' };
      setVideoInfo([]);
      log('停止播放');
    });

    subtitleSelect.addEventListener('change', () => {
      const val = subtitleSelect.value;
      if (hls && hls.subtitleTracks && hls.subtitleTracks.length) {
        if (val === 'off') {
          hls.subtitleTrack = -1;
          log('关闭字幕');
        } else {
          hls.subtitleTrack = Number(val);
          log('切换字幕', { index: val });
        }
        return;
      }

      const tracks = player.textTracks || [];
      for (let i = 0; i < tracks.length; i += 1) {
        tracks[i].mode = 'disabled';
      }
      if (val !== 'off' && tracks[Number(val)]) {
        tracks[Number(val)].mode = 'showing';
        log('切换字幕', { index: val, label: tracks[Number(val)].label });
      } else {
        log('关闭字幕');
      }
    });

    subtitleSize.addEventListener('input', () => {
      setSubtitleSize(subtitleSize.value);
    });

    audioSelect.addEventListener('change', () => {
      const idx = Number(audioSelect.value);
      if (hls && hls.audioTracks && hls.audioTracks.length) {
        hls.audioTrack = idx;
        log('切换音轨', { index: idx });
        return;
      }
      if (!player.audioTracks) {
        log('音轨切换不可用');
        return;
      }
      for (let i = 0; i < player.audioTracks.length; i += 1) {
        player.audioTracks[i].enabled = i === idx;
      }
      log('切换音轨', { index: idx });
    });

    audioRefresh.addEventListener('click', () => {
      refreshAudioList();
      log('刷新音轨列表');
    });

    modalCancel.addEventListener('click', () => {
      pendingIsoFile = null;
      hideBackendModal();
    });
    modalConfirm.addEventListener('click', async () => {
      hideBackendModal();
      if (pendingIsoFile) {
        await uploadIsoAndPlay(pendingIsoFile);
        pendingIsoFile = null;
      }
    });
    backendModal.addEventListener('click', (e) => {
      if (e.target === backendModal) hideBackendModal();
    });

    (async () => {
      try {
        const mod = await import('hls.js');
        HlsLib = mod.default;
        log('Hls.js 已加载', { supported: HlsLib.isSupported() });
      } catch (e) {
        log('Hls.js 加载失败', e);
      }
    })();

    setSubtitleSize(subtitleSize.value);
    setInterval(updateUi, 500);
    updateUi();

    function updateUiStatus(text) {
      uiCards.state.textContent = text;
    }
  </script>
</MainGridLayout>
