---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
---

<MainGridLayout 
  title="实用工具" 
  description="各种在线工具集合"
>
  <div class="onload-animation space-y-6">
    <section class="card-base rounded-[var(--radius-large)] p-8">
      <div class="flex items-center gap-4">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-[var(--primary)] rounded-2xl">
          <Icon name="material-symbols:build" class="text-[var(--primary)] text-3xl" />
        </div>
        <div>
          <h1 class="text-3xl font-bold text-[var(--primary)]">实用工具</h1>
          <p class="text-75 mt-2">各种在线工具集合，所有工具均在本地浏览器运行</p>
        </div>
      </div>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

      <a href="/qrcode/" class="card-base rounded-[var(--radius-large)] p-6 group hover:border-[var(--primary)] transition-all duration-300 hover:shadow-lg hover:-translate-y-1 block">
        <div class="flex items-start gap-4">
          <div class="inline-flex items-center justify-center w-14 h-14 bg-violet-500/10 rounded-xl group-hover:bg-violet-500/20 transition-colors">
            <Icon name="material-symbols:qr-code-2" class="text-violet-500 text-2xl" />
          </div>
          <div class="flex-1">
            <h2 class="text-lg font-bold text-90 group-hover:text-[var(--primary)] transition-colors mb-2">
              二维码生成器
            </h2>
            <p class="text-75 text-60">
              支持文本、URL、WiFi、名片
            </p>
          </div>
        </div>
      </a>

      <a href="/timestamp/" class="card-base rounded-[var(--radius-large)] p-6 group hover:border-[var(--primary)] transition-all duration-300 hover:shadow-lg hover:-translate-y-1 block">
        <div class="flex items-start gap-4">
          <div class="inline-flex items-center justify-center w-14 h-14 bg-amber-500/10 rounded-xl group-hover:bg-amber-500/20 transition-colors">
            <Icon name="material-symbols:schedule" class="text-amber-500 text-2xl" />
          </div>
          <div class="flex-1">
            <h2 class="text-lg font-bold text-90 group-hover:text-[var(--primary)] transition-colors mb-2">
              时间戳转换器
            </h2>
            <p class="text-75 text-60">
              Unix 时间戳与日期格式互转
            </p>
          </div>
        </div>
      </a>

      <a href="/browserinfo/" class="card-base rounded-[var(--radius-large)] p-6 group hover:border-[var(--primary)] transition-all duration-300 hover:shadow-lg hover:-translate-y-1 block">
        <div class="flex items-start gap-4">
          <div class="inline-flex items-center justify-center w-14 h-14 bg-blue-500/10 rounded-xl group-hover:bg-blue-500/20 transition-colors">
            <Icon name="material-symbols:browse" class="text-blue-500 text-2xl" />
          </div>
          <div class="flex-1">
            <h2 class="text-lg font-bold text-90 group-hover:text-[var(--primary)] transition-colors mb-2">
              浏览器信息检测
            </h2>
            <p class="text-75 text-60">
              检测浏览器、设备及隐私指纹
            </p>
          </div>
        </div>
      </a>

      <a href="/miwear-auth/" class="card-base rounded-[var(--radius-large)] p-6 group hover:border-[var(--primary)] transition-all duration-300 hover:shadow-lg hover:-translate-y-1 block">
        <div class="flex items-start gap-4">
          <div class="inline-flex items-center justify-center w-14 h-14 bg-orange-500/10 rounded-xl group-hover:bg-orange-500/20 transition-colors">
            <Icon name="material-symbols:key" class="text-orange-500 text-2xl" />
          </div>
          <div class="flex-1">
            <h2 class="text-lg font-bold text-90 group-hover:text-[var(--primary)] transition-colors mb-2">
              小米AuthKey提取器
            </h2>
            <p class="text-75 text-60">
              从日志或数据库提取 AuthKey
            </p>
          </div>
        </div>
      </a>

      <a href="/Xiaomi-Wearable-Unlock/" class="card-base rounded-[var(--radius-large)] p-6 group hover:border-[var(--primary)] transition-all duration-300 hover:shadow-lg hover:-translate-y-1 block">
        <div class="flex items-start gap-4">
          <div class="inline-flex items-center justify-center w-14 h-14 bg-purple-500/10 rounded-xl group-hover:bg-purple-500/20 transition-colors">
            <Icon name="material-symbols:lock-open" class="text-purple-500 text-2xl" />
          </div>
          <div class="flex-1">
            <h2 class="text-lg font-bold text-90 group-hover:text-[var(--primary)] transition-colors mb-2">
              设备解锁码计算
            </h2>
            <p class="text-75 text-60">
              计算小米穿戴设备解锁码
            </p>
          </div>
        </div>
      </a>

      <a href="/bplist-extractor/" class="card-base rounded-[var(--radius-large)] p-6 group hover:border-[var(--primary)] transition-all duration-300 hover:shadow-lg hover:-translate-y-1 block">
        <div class="flex items-start gap-4">
          <div class="inline-flex items-center justify-center w-14 h-14 bg-emerald-500/10 rounded-xl group-hover:bg-emerald-500/20 transition-colors">
            <Icon name="material-symbols:data-object" class="text-emerald-500 text-2xl" />
          </div>
          <div class="flex-1">
            <h2 class="text-lg font-bold text-90 group-hover:text-[var(--primary)] transition-colors mb-2">
              bplist00 数据提取器
            </h2>
            <p class="text-75 text-60">
              从十进制字节流提取 Apple bplist 设备信息
            </p>
          </div>
        </div>
      </a>

      <a href="/webm-to-mp4/" class="card-base rounded-[var(--radius-large)] p-6 group hover:border-[var(--primary)] transition-all duration-300 hover:shadow-lg hover:-translate-y-1 block">
        <div class="flex items-start gap-4">
          <div class="inline-flex items-center justify-center w-14 h-14 bg-cyan-500/10 rounded-xl group-hover:bg-cyan-500/20 transition-colors">
            <Icon name="material-symbols:movie-edit-outline" class="text-cyan-500 text-2xl" />
          </div>
          <div class="flex-1">
            <h2 class="text-lg font-bold text-90 group-hover:text-[var(--primary)] transition-colors mb-2">
              WEBM 转 MP4
            </h2>
            <p class="text-75 text-60">
              本地转码，支持压缩率调节
            </p>
          </div>
        </div>
      </a>

    </div>
  </div>
</MainGridLayout>
