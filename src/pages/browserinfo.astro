---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
---

<MainGridLayout title="浏览器信息检测" description="全面检测您的浏览器、设备及隐私指纹特征">
  <div class="onload-animation space-y-6">
    <section class="card-base rounded-[var(--radius-large)] p-8">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="flex items-center gap-4">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-[var(--primary)] rounded-2xl">
            <Icon name="material-symbols:browse" class="text-90 text-3xl" />
          </div>
          <div>
            <h1 class="text-3xl font-bold text-90">浏览器信息检测</h1>
            <p class="text-75 mt-2">全面检测您的浏览器、设备及隐私指纹特征</p>
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <button id="refresh-btn" class="px-4 py-2 text-sm font-medium text-90 bg-[var(--primary)] rounded-lg hover:opacity-90 transition">
            重新检测
          </button>
          <button id="copy-all-btn" class="px-4 py-2 text-sm font-medium text-90 bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg hover:border-[var(--primary)] transition">
            复制全部
          </button>
        </div>
      </div>
      <div id="status-msg" class="text-xs text-gray-500 mt-4" aria-live="polite">正在自动检测中…</div>
    </section>

    <section class="card-base rounded-[var(--radius-large)] p-6">
      <h2 class="text-xl font-bold text-90 mb-4 flex items-center">
        <Icon name="material-symbols:monitoring" class="mr-2 text-[var(--primary)]" />
        检测结果
      </h2>

      <div class="bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg p-4 min-h-[220px]">
        <pre id="output-area" class="text-75 text-sm font-mono whitespace-pre-wrap break-words">正在自动检测中…</pre>
      </div>
    </section>
  </div>

  <style></style>

  <script is:inline>
    async function detectBrowserInfo() {
      const info = {};

      info['浏览器'] = getBrowser();
      info['版本'] = getBrowserVersion();
      info['内核'] = getEngine();
      info['操作系统'] = getOS();
      info['设备类型'] = getDeviceType();
      info['硬件平台'] = navigator.hardwareConcurrency ? `多核 (${navigator.hardwareConcurrency} 核)` : (navigator.platform || '未知');
      info['语言'] = navigator.language || '未知';
      info['CPU 架构'] = navigator.userAgentData?.architecture || '未知';
      info['CPU 位数'] = guessCpuBits();
      info['网络在线'] = navigator.onLine ? '是' : '否';
      info['屏幕分辨率'] = `${window.screen.width} × ${window.screen.height}`;
      info['可用分辨率'] = `${window.screen.availWidth} × ${window.screen.availHeight}`;
      info['颜色深度'] = `${window.screen.colorDepth} 位`;
      info['屏幕方向'] = window.screen.orientation?.type || '未知';

      info['localStorage'] = isSupported(() => localStorage);
      info['sessionStorage'] = isSupported(() => sessionStorage);
      info['IndexedDB'] = isSupported(() => indexedDB);
      info['Service Worker'] = 'serviceWorker' in navigator ? '支持' : '不支持';
      info['WebRTC'] = isSupported(() => window.RTCPeerConnection);
      info['剪贴板 API'] = 'clipboard' in navigator ? '支持' : '不支持';
      info['媒体设备 (getUserMedia)'] = isSupported(() => navigator.mediaDevices?.getUserMedia);
      info['Web Audio API'] = isSupported(() => window.AudioContext || window.webkitAudioContext);

      info['WebDriver'] = navigator.webdriver === true ? '是（可能为自动化）' : '否';
      info['Headless 检测'] = detectHeadless();

      info['应用名称 (appName)'] = navigator.appName;
      info['应用版本 (appVersion)'] = navigator.appVersion;
      info['平台信息 (platform)'] = navigator.platform;
      info['产品标识 (product)'] = navigator.product;
      info['产品子版本 (productSub)'] = navigator.productSub;
      info['厂商信息 (vendor)'] = navigator.vendor || 'N/A';
      info['用户代理字符串 (userAgent)'] = navigator.userAgent;
      info['Cookie 是否启用'] = navigator.cookieEnabled ? '是' : '否';
      info['MIME 类型数量'] = navigator.mimeTypes?.length || 0;
      info['插件数量'] = navigator.plugins?.length || 0;
      info['设备内存 (GB)'] = navigator.deviceMemory ? `${navigator.deviceMemory} GB` : '未知';
      info['逻辑 CPU 核心数'] = navigator.hardwareConcurrency || '未知';

      if (navigator.connection) {
        const conn = navigator.connection;
        info['网络类型'] = conn.effectiveType || '未知';
        info['下行带宽估算 (Mbps)'] = conn.downlink ? conn.downlink : '未知';
        info['RTT (ms)'] = conn.rtt || '未知';
      } else {
        info['网络类型'] = '不支持 Network Information API';
      }

      try {
        const battery = await navigator.getBattery?.();
        if (battery) {
          info['电池充电中'] = battery.charging ? '是' : '否';
          info['电池电量'] = `${Math.round(battery.level * 100)}%`;
          info['预计充满时间'] = battery.chargingTime === Infinity ? '已充满' : `${battery.chargingTime}s`;
        } else {
          info['电池信息'] = '不支持或未授权';
        }
      } catch {
        info['电池信息'] = '获取失败';
      }

      info['Canvas 画布指纹'] = getCanvasFingerprint();
      info['WebGL 图像指纹'] = getWebGLFingerprint();
      info['字体列表指纹'] = await getFontFingerprint();
      info['音频上下文指纹'] = getAudioFingerprint();

      const fingerprintStr = Object.values(info).join('|');
      info['综合特征指纹 (SHA-256 前 16 位)'] = await hashFingerprint(fingerprintStr);

      return info;
    }

    function renderPlainOutput(info) {
      let outputText = '';
      for (const [key, value] of Object.entries(info)) {
        outputText += `${key}: ${value}\n`;
      }
      document.getElementById('output-area').textContent = outputText;
    }

    function copyText(text) {
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(() => updateStatus('已复制到剪贴板'));
      } else {
        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        try {
          document.execCommand('copy');
          updateStatus('已复制到剪贴板');
        } catch {}
        document.body.removeChild(textarea);
      }
    }

    function updateStatus(message) {
      const el = document.getElementById('status-msg');
      if (!el) return;
      el.textContent = message;
      clearTimeout(el._t);
      el._t = setTimeout(() => {
        el.textContent = '检测结果已更新';
      }, 1500);
    }


    function getBrowser() {
      const ua = navigator.userAgent;
      if (ua.includes('Edg')) return 'Edge';
      if (ua.includes('OPR') || ua.includes('Opera')) return 'Opera';
      if (ua.includes('Firefox')) return 'Firefox';
      if (ua.includes('Chrome')) return 'Chrome';
      if (ua.includes('Safari')) return 'Safari';
      return '未知浏览器';
    }

    function getBrowserVersion() {
      const ua = navigator.userAgent;
      const match = ua.match(/(Edg|OPR|Opera|Firefox|Chrome|Safari)\/([\d.]+)/);
      return match ? match[2] : '未知';
    }

    function getEngine() {
      const ua = navigator.userAgent;
      if (ua.includes('WebKit') && !ua.includes('Chrome')) return 'WebKit (Safari)';
      if (ua.includes('Blink')) return 'Blink (Chrome/Edge/Opera)';
      if (ua.includes('Gecko') && ua.includes('Firefox')) return 'Gecko (Firefox)';
      if (ua.includes('Trident') || ua.includes('MSIE')) return 'Trident (IE)';
      return '未知内核';
    }

    function getOS() {
      const ua = navigator.userAgent;
      if (ua.includes('Win')) return 'Windows';
      if (ua.includes('Mac')) return 'macOS';
      if (ua.includes('Linux')) return 'Linux';
      if (ua.includes('Android')) return 'Android';
      if (ua.includes('iPhone') || ua.includes('iPad')) return 'iOS';
      return '未知操作系统';
    }

    function getDeviceType() {
      if (/Mobi|Android/i.test(navigator.userAgent)) return '移动设备';
      return '桌面设备';
    }

    function guessCpuBits() {
      if (navigator.userAgent.includes('WOW64') || navigator.userAgent.includes('Win64')) return '64 位';
      if (navigator.platform.includes('64')) return '64 位';
      return '32 位（推测）';
    }

    function isSupported(fn) {
      try {
        fn();
        return '支持';
      } catch {
        return '不支持';
      }
    }

    function detectHeadless() {
      if (/HeadlessChrome/.test(navigator.userAgent)) return '是（Headless Chrome）';
      if (!window.outerWidth || !window.outerHeight) return '可能（窗口尺寸异常）';
      if (navigator.plugins.length === 0) return '可能（无插件）';
      return '否';
    }

    function getCanvasFingerprint() {
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');
      ctx.textBaseline = 'top';
      ctx.font = '14px Arial';
      ctx.fillText('Browser Fingerprint Test', 2, 2);
      return canvas.toDataURL().slice(-20);
    }

    function getWebGLFingerprint() {
      try {
        const canvas = document.createElement('canvas');
        const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
        if (!gl) return '不支持 WebGL';
        const debugInfo = gl.getExtension('WEBGL_debug_renderer_info');
        if (debugInfo) {
          const vendor = gl.getParameter(debugInfo.UNMASKED_VENDOR_WEBGL);
          const renderer = gl.getParameter(debugInfo.UNMASKED_RENDERER_WEBGL);
          return `${vendor} / ${renderer}`;
        }
        return '支持但无法读取型号';
      } catch {
        return 'WebGL 初始化失败';
      }
    }

    async function getFontFingerprint() {
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');
      ctx.font = '72px Arial, Helvetica, sans-serif';
      const width = ctx.measureText('mmmmmmmmmmlli').width;
      return `字体渲染宽度: ${width}px`;
    }

    function getAudioFingerprint() {
      try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const oscillator = audioCtx.createOscillator();
        const analyser = audioCtx.createAnalyser();
        oscillator.connect(analyser);
        analyser.connect(audioCtx.destination);
        const fingerprint = analyser.channelCount + '-' + analyser.fftSize;
        oscillator.disconnect();
        analyser.disconnect();
        audioCtx.close();
        return fingerprint;
      } catch {
        return '不支持 Web Audio API';
      }
    }

    async function hashFingerprint(str) {
      const enc = new TextEncoder();
      const data = enc.encode(str);
      const hashBuf = await crypto.subtle.digest('SHA-256', data);
      const hashArray = Array.from(new Uint8Array(hashBuf));
      const hex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
      return hex.substring(0, 16);
    }

    if (typeof window !== 'undefined') {
      let currentInfo = null;

      const refresh = async () => {
        updateStatus('正在检测…');
        currentInfo = await detectBrowserInfo().catch(() => null);
        if (!currentInfo) {
          updateStatus('检测失败，请刷新重试');
          return;
        }
        renderPlainOutput(currentInfo);
        updateStatus('检测结果已更新');
      };

      window.addEventListener('load', refresh);

      document.getElementById('refresh-btn')?.addEventListener('click', refresh);

      document.getElementById('copy-all-btn')?.addEventListener('click', () => {
        if (!currentInfo) {
          updateStatus('暂无可复制内容');
          return;
        }
        let text = '';
        for (const [k, v] of Object.entries(currentInfo)) {
          text += `${k}: ${v}\n`;
        }
        copyText(text);
      });

    }
  </script>
</MainGridLayout>
