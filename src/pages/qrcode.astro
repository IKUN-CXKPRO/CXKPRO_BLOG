---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
---

<MainGridLayout title="二维码生成器" description="生成各种内容的二维码">
  <div class="onload-animation space-y-6">
    <!-- 头部 -->
    <section class="card-base rounded-[var(--radius-large)] p-8">
      <div class="flex items-center gap-4">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-violet-500 rounded-2xl">
          <Icon name="material-symbols:qr-code-2" class="text-[var(--primary)] text-3xl" />
        </div>
        <div>
          <h1 class="text-3xl font-bold text-90">二维码生成器</h1>
          <p class="text-75 mt-2">支持文本、URL、WiFi、名片等多种内容</p>
        </div>
      </div>
    </section>

    <!-- 输入区域 -->
    <section class="card-base rounded-[var(--radius-large)] p-6">
      <label class="block text-sm font-medium text-90 mb-3">输入内容</label>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="space-y-4">
          <!-- 内容类型 -->
          <div class="flex flex-wrap gap-2">
            <button class="type-btn active px-4 py-2 rounded-lg text-sm font-medium" data-type="text">
              <Icon name="material-symbols:text-fields" class="inline mr-1" />文本
            </button>
            <button class="type-btn px-4 py-2 rounded-lg text-sm font-medium" data-type="url">
              <Icon name="material-symbols:link" class="inline mr-1" />URL
            </button>
            <button class="type-btn px-4 py-2 rounded-lg text-sm font-medium" data-type="wifi">
              <Icon name="material-symbols:wifi" class="inline mr-1" />WiFi
            </button>
            <button class="type-btn px-4 py-2 rounded-lg text-sm font-medium" data-type="vcard">
              <Icon name="material-symbols:contact-page" class="inline mr-1" />名片
            </button>
          </div>

          <!-- 文本输入 -->
          <textarea id="textInput" class="w-full h-40 p-4 bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg font-mono text-sm focus:outline-none focus:border-[var(--primary)]" placeholder="输入文本内容..."></textarea>

          <!-- WiFi 表单 -->
          <div id="wifiForm" class="hidden space-y-3">
            <input type="text" id="wifiName" placeholder="WiFi 名称 (SSID)" class="w-full px-4 py-3 bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg focus:outline-none focus:border-[var(--primary)]" />
            <input type="password" id="wifiPassword" placeholder="密码" class="w-full px-4 py-3 bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg focus:outline-none focus:border-[var(--primary)]" />
            <select id="wifiEncryption" class="w-full px-4 py-3 bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg focus:outline-none focus:border-[var(--primary)]">
              <option value="WPA">WPA/WPA2</option>
              <option value="WEP">WEP</option>
              <option value="">无密码</option>
            </select>
          </div>

          <!-- 名片表单 -->
          <div id="vcardForm" class="hidden space-y-3">
            <input type="text" id="vcardName" placeholder="姓名" class="w-full px-4 py-3 bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg focus:outline-none focus:border-[var(--primary)]" />
            <input type="tel" id="vcardPhone" placeholder="电话" class="w-full px-4 py-3 bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg focus:outline-none focus:border-[var(--primary)]" />
            <input type="email" id="vcardEmail" placeholder="邮箱" class="w-full px-4 py-3 bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg focus:outline-none focus:border-[var(--primary)]" />
            <input type="url" id="vcardUrl" placeholder="网站" class="w-full px-4 py-3 bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg focus:outline-none focus:border-[var(--primary)]" />
          </div>
        </div>

        <!-- 二维码预览 -->
        <div class="flex flex-col items-center justify-center">
          <div class="bg-white p-6 rounded-xl">
            <canvas id="qrCanvas" width="240" height="240"></canvas>
          </div>
          <p id="qrError" class="text-red-500 text-sm mt-4 hidden">请输入内容生成二维码</p>
        </div>
      </div>
    </section>

    <!-- 设置 -->
    <section class="card-base rounded-[var(--radius-large)] p-6">
      <label class="block text-sm font-medium text-90 mb-4">二维码设置</label>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <label class="block text-xs text-60 mb-2">大小: <span id="sizeValue">240px</span></label>
          <input type="range" id="sizeSlider" min="100" max="400" value="240" class="w-full" />
        </div>
        <div>
          <label class="block text-xs text-60 mb-2">容错率: <span id="errorValue">15%</span></label>
          <select id="errorLevel" class="w-full px-4 py-2 bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg">
            <option value="L">L - 7%</option>
            <option value="M">M - 15%</option>
            <option value="Q">Q - 25%</option>
            <option value="H">H - 30%</option>
          </select>
        </div>
        <div>
          <label class="block text-xs text-60 mb-2">前景色</label>
          <input type="color" id="fgColor" value="#000000" class="w-full h-10 rounded-lg cursor-pointer" />
        </div>
      </div>
    </section>

    <!-- 操作按钮 -->
    <section class="card-base rounded-[var(--radius-large)] p-6">
      <div class="flex flex-wrap gap-3">
        <button id="generateBtn" class="btn-primary px-5 py-2.5 rounded-lg font-medium">
          <Icon name="material-symbols:refresh" class="inline mr-2" />生成
        </button>
        <button id="downloadPng" class="btn-secondary px-5 py-2.5 rounded-lg font-medium">
          <Icon name="material-symbols:download" class="inline mr-2" />下载 PNG
        </button>
        <button id="downloadSvg" class="btn-secondary px-5 py-2.5 rounded-lg font-medium">
          <Icon name="material-symbols:download" class="inline mr-2" />下载 SVG
        </button>
      </div>
    </section>
  </div>

  <style>
    .type-btn {
      background: var(--btn-regular-bg);
      color: var(--btn-content);
      border: 1px solid var(--line-divider);
    }
    .type-btn.active {
      background: var(--primary);
      color: white;
      border-color: var(--primary);
    }
    .type-btn:hover:not(.active) {
      border-color: var(--primary);
    }
    .btn-primary {
      background: linear-gradient(135deg, #8b5cf6, #7c3aed);
      color: white;
    }
    .btn-secondary {
      background: var(--btn-regular-bg);
      color: var(--btn-content);
      border: 1px solid var(--line-divider);
    }
    /* 输入框自适应颜色 */
    input[type="text"],
    input[type="password"],
    input[type="tel"],
    input[type="email"],
    input[type="url"],
    input[type="datetime-local"],
    textarea {
      color: var(--text-color);
    }
    input[type="text"]::placeholder,
    input[type="password"]::placeholder,
    input[type="tel"]::placeholder,
    input[type="email"]::placeholder,
    input[type="url"]::placeholder,
    textarea::placeholder {
      color: var(--text-60);
    }
    select {
      color: var(--text-color);
    }
    input[type="range"] {
      -webkit-appearance: none;
      height: 6px;
      background: var(--line-divider);
      border-radius: 3px;
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 16px;
      height: 16px;
      background: var(--primary);
      border-radius: 50%;
      cursor: pointer;
    }
  </style>

  <script>
    // QRCode.js 库 - 使用简单实现
    const QRCode = (await import('qrcode')).default;

    const canvas = document.getElementById('qrCanvas') as HTMLCanvasElement;
    const textInput = document.getElementById('textInput') as HTMLTextAreaElement;
    const qrError = document.getElementById('qrError') as HTMLElement;
    const wifiForm = document.getElementById('wifiForm') as HTMLElement;
    const vcardForm = document.getElementById('vcardForm') as HTMLElement;
    const sizeSlider = document.getElementById('sizeSlider') as HTMLInputElement;
    const sizeValue = document.getElementById('sizeValue') as HTMLElement;
    const errorLevel = document.getElementById('errorLevel') as HTMLSelectElement;
    const errorValue = document.getElementById('errorValue') as HTMLElement;
    const fgColor = document.getElementById('fgColor') as HTMLInputElement;

    let currentType = 'text';

    function generateWifiString(): string {
      const ssid = (document.getElementById('wifiName') as HTMLInputElement).value;
      const password = (document.getElementById('wifiPassword') as HTMLInputElement).value;
      const encryption = (document.getElementById('wifiEncryption') as HTMLSelectElement).value;
      
      const escape = (s: string) => s.replace(/([\\;,:"'])/g, '\\$1');
      return `WIFI:T:${encryption};S:${escape(ssid)};P:${escape(password)};;`;
    }

    function generateVcardString(): string {
      const name = (document.getElementById('vcardName') as HTMLInputElement).value;
      const phone = (document.getElementById('vcardPhone') as HTMLInputElement).value;
      const email = (document.getElementById('vcardEmail') as HTMLInputElement).value;
      const url = (document.getElementById('vcardUrl') as HTMLInputElement).value;
      
      return `BEGIN:VCARD\nVERSION:3.0\nN:${name}\nTEL:${phone}\nEMAIL:${email}\nURL:${url}\nEND:VCARD`;
    }

    function getContent(): string {
      switch (currentType) {
        case 'wifi': return generateWifiString();
        case 'vcard': return generateVcardString();
        case 'url':
          let url = textInput.value.trim();
          if (!url.startsWith('http')) url = 'https://' + url;
          return url;
        default: return textInput.value;
      }
    }

    async function generateQR() {
      const content = getContent();
      if (!content) {
        qrError.classList.remove('hidden');
        return;
      }
      qrError.classList.add('hidden');

      const size = parseInt(sizeSlider.value);
      canvas.width = size;
      canvas.height = size;

      try {
        await QRCode.toCanvas(canvas, content, {
          width: size,
          margin: 2,
          errorCorrectionLevel: errorLevel.value as any,
          color: {
            dark: fgColor.value,
            light: '#ffffff'
          }
        });
      } catch (e) {
        console.error(e);
      }
    }

    // 事件绑定
    document.querySelectorAll('.type-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.type-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentType = btn.getAttribute('data-type') || 'text';
        
        wifiForm.classList.toggle('hidden', currentType !== 'wifi');
        vcardForm.classList.toggle('hidden', currentType !== 'vcard');
        textInput.classList.toggle('hidden', currentType === 'wifi' || currentType === 'vcard');
      });
    });

    document.getElementById('generateBtn')?.addEventListener('click', generateQR);
    
    sizeSlider.addEventListener('input', () => {
      sizeValue.textContent = sizeSlider.value + 'px';
      generateQR();
    });

    errorLevel.addEventListener('change', () => {
      const levels: Record<string, string> = { L: '7%', M: '15%', Q: '25%', H: '30%' };
      errorValue.textContent = levels[errorLevel.value] || '15%';
      generateQR();
    });

    fgColor.addEventListener('input', generateQR);

    textInput.addEventListener('input', generateQR);
    wifiForm.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', generateQR);
    });
    vcardForm.querySelectorAll('input').forEach(el => {
      el.addEventListener('input', generateQR);
    });

    document.getElementById('downloadPng')?.addEventListener('click', () => {
      const link = document.createElement('a');
      link.download = 'qrcode.png';
      link.href = canvas.toDataURL('image/png');
      link.click();
    });

    document.getElementById('downloadSvg')?.addEventListener('click', async () => {
      const content = getContent();
      if (!content) return;
      
      try {
        const svg = await QRCode.toString(content, { type: 'svg', errorCorrectionLevel: errorLevel.value as any });
        const blob = new Blob([svg], { type: 'image/svg+xml' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.download = 'qrcode.svg';
        link.href = url;
        link.click();
        URL.revokeObjectURL(url);
      } catch (e) {
        console.error(e);
      }
    });

    // 初始生成
    generateQR();
  </script>
</MainGridLayout>
