---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
---

<MainGridLayout title="WEBM 转 MP4" description="本地浏览器转码，支持压缩率调节">
  <div class="onload-animation space-y-6">
    <section class="card-base rounded-[var(--radius-large)] p-8">
      <div class="flex items-center gap-4">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-cyan-500/15 rounded-2xl">
          <Icon name="material-symbols:movie-edit-outline" class="text-cyan-500 text-3xl" />
        </div>
        <div>
          <h1 class="text-3xl font-bold text-90">WEBM 转 MP4</h1>
          <p class="text-75 mt-2">本地处理，不上传文件。可调压缩率，兼顾清晰度与体积。</p>
        </div>
      </div>
    </section>

    <section class="card-base rounded-[var(--radius-large)] p-6 space-y-5">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div>
          <label class="block text-sm font-medium text-90 mb-2">输入 WEBM 文件</label>
          <input id="fileInput" type="file" accept="video/webm,.webm" class="w-full px-4 py-3 bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg text-90" />
          <p class="text-xs text-60 mt-2">单文件上限 3GB，建议优先使用时长较短的视频。</p>
        </div>

        <div>
          <label for="crfSlider" class="block text-sm font-medium text-90 mb-2">
            压缩率（CRF）：<span id="crfValue" class="font-mono text-[var(--primary)]">23</span>
          </label>
          <input id="crfSlider" type="range" min="18" max="35" value="23" class="w-full" />
          <div class="flex justify-between text-xs text-60 mt-1">
            <span>清晰优先</span>
            <span>体积优先</span>
          </div>
        </div>
      </div>

      <div id="previewWrap" class="hidden">
        <p class="block text-sm font-medium text-90 mb-2">WEBM 预览</p>
        <div class="rounded-lg border border-[var(--line-divider)] bg-[var(--card-bg)] p-3">
          <video id="previewPlayer" class="w-full rounded-md bg-black max-h-[22rem]" controls playsinline preload="metadata"></video>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="md:col-span-1">
          <label class="block text-sm font-medium text-90 mb-2">WASM 核心来源</label>
          <select id="coreSource" class="w-full px-4 py-3 bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg text-90">
            <option value="embedded">站内内置（推荐）</option>
            <option value="cdn">CDN</option>
            <option value="custom">自定义 URL</option>
          </select>
        </div>
        <div id="customCoreGroup" class="md:col-span-2 hidden grid grid-cols-1 md:grid-cols-2 gap-3">
          <input id="customCoreJs" type="url" placeholder="ffmpeg-core.js URL" class="w-full px-4 py-3 bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg text-90" />
          <input id="customCoreWasm" type="url" placeholder="ffmpeg-core.wasm URL" class="w-full px-4 py-3 bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg text-90" />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-90 mb-2">编码器</label>
            <select id="encoderSelect" class="w-full px-4 py-3 bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg text-90">
              <option value="h264">H.264（兼容性优先）</option>
              <option value="h265">H.265（更高压缩率）</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-90 mb-2">转码速度策略</label>
            <select id="speedPresetSelect" class="w-full px-4 py-3 bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg text-90">
              <option value="ultrafast">极速（画质与体积优先级最低）</option>
              <option value="veryfast" selected>推荐（速度优先）</option>
              <option value="faster">均衡</option>
              <option value="medium">画质优先（较慢）</option>
            </select>
          </div>
          <label class="flex items-center gap-2 text-sm text-90">
            <input id="verboseLogToggle" type="checkbox" class="accent-[var(--primary)]" />
            <span>详细日志（关闭可减少界面输出）</span>
          </label>
          <div class="p-4 rounded-lg bg-[var(--card-bg)] border border-[var(--line-divider)] text-xs text-60">
            提示：已自动开启多线程转码，速度根据设备性能优化。
          </div>
          <div class="p-4 rounded-lg bg-[var(--card-bg)] border border-[var(--line-divider)] text-xs text-60">
            提示：H.265 压缩更强，但某些老设备兼容性较弱。
          </div>
        </div>
        <div>
          <p class="block text-sm font-medium text-90 mb-2">运行日志</p>
          <div id="logBox" class="h-44 md:h-56 p-3 rounded-lg bg-[var(--card-bg)] border border-[var(--line-divider)] text-xs text-75 font-mono overflow-y-auto overflow-x-hidden break-words"></div>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <button id="startBtn" class="btn-primary px-5 py-2.5 rounded-lg font-medium">
          <Icon name="material-symbols:play-arrow" class="inline mr-1" />开始转换
        </button>
        <button id="downloadBtn" disabled class="btn-secondary px-5 py-2.5 rounded-lg font-medium opacity-50 cursor-not-allowed">
          <Icon name="material-symbols:download" class="inline mr-1" />下载 MP4
        </button>
      </div>

      <div class="space-y-2">
        <div class="flex justify-between text-xs text-75">
          <span id="statusText">等待文件</span>
          <span id="progressText">0%</span>
        </div>
        <div class="h-2 rounded-full bg-[var(--line-divider)] overflow-hidden">
          <div id="progressBar" class="h-full bg-[var(--primary)] w-0 transition-all duration-300"></div>
        </div>
      </div>

      <div id="resultBox" class="hidden p-4 rounded-lg bg-[var(--card-bg)] border border-[var(--line-divider)]">
        <p class="text-sm text-90">转换完成</p>
        <p id="resultMeta" class="text-xs text-60 mt-1"></p>
      </div>
    </section>
  </div>

  <style>
    .btn-primary {
      background: var(--primary);
      color: white;
    }
    .btn-primary:hover {
      filter: brightness(0.95);
    }
    .btn-secondary {
      background: var(--btn-regular-bg);
      color: var(--btn-content);
      border: 1px solid var(--line-divider);
    }
    input[type="range"] {
      -webkit-appearance: none;
      height: 6px;
      background: var(--line-divider);
      border-radius: 999px;
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 16px;
      height: 16px;
      border-radius: 999px;
      background: var(--primary);
      cursor: pointer;
    }
  </style>

  <script>
    import localCoreURL from "@ffmpeg/core?url";
    import localWasmURL from "@ffmpeg/core/wasm?url";

    type FFmpegType = any;

    const MAX_FILE_SIZE = 3 * 1024 * 1024 * 1024;
    const fileInput = document.getElementById("fileInput") as HTMLInputElement;
    const crfSlider = document.getElementById("crfSlider") as HTMLInputElement;
    const crfValue = document.getElementById("crfValue") as HTMLSpanElement;
    const previewWrap = document.getElementById("previewWrap") as HTMLDivElement;
    const previewPlayer = document.getElementById("previewPlayer") as HTMLVideoElement;
    const coreSource = document.getElementById("coreSource") as HTMLSelectElement;
    const encoderSelect = document.getElementById("encoderSelect") as HTMLSelectElement;
    const speedPresetSelect = document.getElementById("speedPresetSelect") as HTMLSelectElement;
    const verboseLogToggle = document.getElementById("verboseLogToggle") as HTMLInputElement;
    const customCoreGroup = document.getElementById("customCoreGroup") as HTMLDivElement;
    const customCoreJs = document.getElementById("customCoreJs") as HTMLInputElement;
    const customCoreWasm = document.getElementById("customCoreWasm") as HTMLInputElement;
    const startBtn = document.getElementById("startBtn") as HTMLButtonElement;
    const downloadBtn = document.getElementById("downloadBtn") as HTMLButtonElement;
    const statusText = document.getElementById("statusText") as HTMLSpanElement;
    const progressText = document.getElementById("progressText") as HTMLSpanElement;
    const progressBar = document.getElementById("progressBar") as HTMLDivElement;
    const resultBox = document.getElementById("resultBox") as HTMLDivElement;
    const resultMeta = document.getElementById("resultMeta") as HTMLParagraphElement;
    const logBox = document.getElementById("logBox") as HTMLDivElement;

    let ffmpeg: FFmpegType | null = null;
    let loadedSourceKey = "";
    let outputBlobUrl = "";
    let outputFileName = "";
    let previewUrl = "";
    let ffmpegLoadPromise: Promise<FFmpegType> | null = null;
    let ffmpegLoadingSince = 0;
    let transcodeStartedAt = 0;
    let lastProgressLogTs = 0;

    const setProgress = (value: number) => {
      const pct = Math.max(0, Math.min(100, Math.floor(value * 100)));
      progressBar.style.width = `${pct}%`;
      progressText.textContent = `${pct}%`;
    };

    const setStatus = (text: string) => {
      statusText.textContent = text;
    };

    const appendLog = (text: string) => {
      const ts = new Date().toLocaleTimeString("zh-CN", { hour12: false });
      logBox.innerHTML += `[${ts}] ${text}<br>`;
      logBox.scrollTop = logBox.scrollHeight;
      console.log(`[webm-to-mp4] ${text}`);
    };

    const elapsed = () => {
      if (!transcodeStartedAt) return "0.0s";
      return `${((performance.now() - transcodeStartedAt) / 1000).toFixed(1)}s`;
    };

    const toggleDownload = (enabled: boolean) => {
      downloadBtn.disabled = !enabled;
      downloadBtn.classList.toggle("opacity-50", !enabled);
      downloadBtn.classList.toggle("cursor-not-allowed", !enabled);
    };

    const resolveCoreURLs = () => {
      if (coreSource.value === "embedded") {
        return {
          sourceKey: "embedded",
          coreURL: localCoreURL,
          wasmURL: localWasmURL
        };
      }
      if (coreSource.value === "custom") {
        return {
          sourceKey: `custom:${customCoreJs.value}|${customCoreWasm.value}`,
          coreURL: customCoreJs.value.trim(),
          wasmURL: customCoreWasm.value.trim()
        };
      }
      return {
        sourceKey: "cdn",
        coreURL: "https://cdn.jsdelivr.net/npm/@ffmpeg/core@0.12.6/dist/esm/ffmpeg-core.js",
        wasmURL: "https://cdn.jsdelivr.net/npm/@ffmpeg/core@0.12.6/dist/esm/ffmpeg-core.wasm"
      };
    };

    const withTimeout = async <T,>(promise: Promise<T>, ms: number, label: string): Promise<T> => {
      let timer: number | null = null;
      const timeoutPromise = new Promise<never>((_, reject) => {
        timer = window.setTimeout(() => reject(new Error(`${label} 超时（>${ms / 1000}s）`)), ms);
      });
      try {
        return await Promise.race([promise, timeoutPromise]);
      } finally {
        if (timer) clearTimeout(timer);
      }
    };

    const ensureFfmpeg = async () => {
      const core = resolveCoreURLs();
      if (ffmpeg && loadedSourceKey === core.sourceKey) return ffmpeg;
      if (ffmpegLoadPromise) {
        const loadingFor = Date.now() - ffmpegLoadingSince;
        if (loadingFor < 30000) {
          appendLog(`复用正在加载的 ffmpeg 实例（${Math.floor(loadingFor / 1000)}s）`);
          return ffmpegLoadPromise;
        }
        appendLog("检测到旧加载任务长时间未完成，触发重试");
        ffmpegLoadPromise = null;
      }

      ffmpegLoadPromise = (async () => {
        setStatus("正在加载本地转码核心...");
        appendLog(`加载 ffmpeg 实例（${core.sourceKey}）`);
        ffmpegLoadingSince = Date.now();
        // @ts-ignore: dynamic ffmpeg import may not have local type declarations
        const ffmpegModule = await import("@ffmpeg/ffmpeg") as any;
        const instance = new ffmpegModule.FFmpeg() as FFmpegType;
        instance.on("progress", (payload: { progress: number }) => setProgress(payload.progress));
        instance.on("log", (payload: { type: string; message: string }) => {
          const { type, message } = payload;
          if (message?.trim()) {
            const m = message.trim();
            if (m.includes("frame=") || m.includes("fps=") || m.includes("time=") || m.includes("speed=")) {
              if (verboseLogToggle.checked) {
                appendLog(`[ffmpeg-${type}] ${m}`);
              } else {
                const now = Date.now();
                if (now - lastProgressLogTs > 1000) {
                  lastProgressLogTs = now;
                  appendLog(`[ffmpeg-${type}] ${m}`);
                }
              }
              return;
            }
            if (m.toLowerCase().includes("error")) {
              appendLog(`[ffmpeg-${type}] ${m}`);
              console.error("[webm-to-mp4] ffmpeg-error-line", m);
              return;
            }
            if (m.startsWith("Input #") || m.startsWith("Output #") || m.startsWith("Stream #")) {
              appendLog(`[ffmpeg-${type}] ${m}`);
              return;
            }
          }
        });

        loadedSourceKey = core.sourceKey;
        try {
          await withTimeout(instance.load({
            coreURL: core.coreURL,
            wasmURL: core.wasmURL
          }), 15000, `加载 ${core.sourceKey} 核心`);
        } catch (error) {
          if (core.sourceKey === "embedded") {
            appendLog("站内内置核心加载失败，自动回退到 CDN");
            const fallback = {
              coreURL: "https://cdn.jsdelivr.net/npm/@ffmpeg/core@0.12.6/dist/esm/ffmpeg-core.js",
              wasmURL: "https://cdn.jsdelivr.net/npm/@ffmpeg/core@0.12.6/dist/esm/ffmpeg-core.wasm"
            };
            await withTimeout(instance.load(fallback), 20000, "加载 CDN 核心");
            loadedSourceKey = "cdn-fallback";
          } else {
            throw error;
          }
        }
        ffmpeg = instance;
        appendLog("ffmpeg 核心加载完成");
        setStatus("核心已就绪，等待转换");
        return instance;
      })();

      try {
        return await ffmpegLoadPromise;
      } finally {
        ffmpegLoadPromise = null;
        ffmpegLoadingSince = 0;
      }
    };

    const humanSize = (size: number) => {
      if (size < 1024) return `${size} B`;
      if (size < 1024 * 1024) return `${(size / 1024).toFixed(1)} KB`;
      return `${(size / (1024 * 1024)).toFixed(2)} MB`;
    };

    crfSlider.addEventListener("input", () => {
      crfValue.textContent = crfSlider.value;
    });

    coreSource.addEventListener("change", () => {
      customCoreGroup.classList.toggle("hidden", coreSource.value !== "custom");
      ffmpeg = null;
      loadedSourceKey = "";
      appendLog(`核心来源切换为：${coreSource.value}`);
      warmupFfmpeg();
    });

    const warmupFfmpeg = () => {
      ensureFfmpeg().catch((error) => {
        console.error(error);
        appendLog(`核心预加载失败：${error instanceof Error ? error.message : String(error)}`);
        setStatus("核心加载失败，可重试转换");
      });
    };

    const updatePreview = (file: File | null) => {
      if (previewUrl) {
        URL.revokeObjectURL(previewUrl);
        previewUrl = "";
      }
      if (!file) {
        previewPlayer.removeAttribute("src");
        previewPlayer.load();
        previewWrap.classList.add("hidden");
        return;
      }
      previewUrl = URL.createObjectURL(file);
      previewPlayer.src = previewUrl;
      previewWrap.classList.remove("hidden");
      appendLog(`预览已就绪：${file.name}`);
    };

    fileInput.addEventListener("change", () => {
      const file = fileInput.files?.[0] ?? null;
      updatePreview(file);
      if (file) {
        console.info("[webm-to-mp4] file-selected", {
          name: file.name,
          size: file.size,
          type: file.type
        });
      }
    });

    startBtn.addEventListener("click", async () => {
      const file = fileInput.files?.[0];
      if (!file) {
        setStatus("请先选择 WEBM 文件");
        console.warn("[webm-to-mp4] no-file-selected");
        return;
      }
      if (file.size > MAX_FILE_SIZE) {
        setStatus(`文件过大，当前 ${humanSize(file.size)}，上限 3GB`);
        console.warn("[webm-to-mp4] file-too-large", { size: file.size });
        return;
      }
      if (coreSource.value === "custom" && (!customCoreJs.value.trim() || !customCoreWasm.value.trim())) {
        setStatus("请填写自定义 core.js 和 core.wasm URL");
        console.warn("[webm-to-mp4] custom-core-missing-url");
        return;
      }

      appendLog(`开始处理文件：${file.name} (${humanSize(file.size)})`);
      toggleDownload(false);
      resultBox.classList.add("hidden");
      setProgress(0);

      try {
        startBtn.disabled = true;
        transcodeStartedAt = performance.now();
        setStatus("准备转码...");
        appendLog("阶段 1/4：准备任务");

        const worker = await ensureFfmpeg();
        const inputName = "input.webm";
        outputFileName = file.name.replace(/\.webm$/i, "") + ".mp4";
        const outputName = "output.mp4";
        const useH265 = encoderSelect.value === "h265";
        const speedPreset = speedPresetSelect.value || "veryfast";
        const effectiveCrf = Number(crfSlider.value);
        const audioBitrate = "128k";
        const threadCount = Math.max(1, Math.min(8, navigator.hardwareConcurrency || 2));
        appendLog(`编码器：${useH265 ? "H.265" : "H.264"}，CRF：${effectiveCrf}，预设：${speedPreset}，线程：${threadCount}`);

        const fileBuffer = new Uint8Array(await file.arrayBuffer());
        setStatus("写入输入文件...");
        appendLog(`阶段 2/4：写入输入文件（${humanSize(fileBuffer.byteLength)}）`);
        await worker.writeFile(inputName, fileBuffer);
        if (worker.deleteFile) {
          try {
            await worker.deleteFile(outputName);
          } catch {
            // ignore missing output file
          }
        }

        setStatus("转码中（本地处理）...");
        appendLog("阶段 3/4：执行 ffmpeg 转码");
        console.info("[webm-to-mp4] transcode-start", {
          encoder: useH265 ? "libx265" : "libx264",
          crf: effectiveCrf,
          preset: speedPreset,
          threads: threadCount,
          coreSource: coreSource.value
        });
        const args = [
          "-y",
          "-i", inputName,
          "-c:v", useH265 ? "libx265" : "libx264",
          "-crf", String(effectiveCrf),
          "-preset", speedPreset,
          "-threads", String(threadCount),
          "-c:a", "aac",
          "-b:a", audioBitrate,
          "-movflags", "+faststart",
          outputName
        ];

        await worker.exec(args);

        appendLog(`阶段 3/4 完成，耗时 ${elapsed()}`);
        appendLog("阶段 4/4：读取输出文件");
        const output = await worker.readFile(outputName) as Uint8Array;
        const normalized = new Uint8Array(Array.from(output));
        const blob = new Blob([normalized as any], { type: "video/mp4" });

        if (outputBlobUrl) URL.revokeObjectURL(outputBlobUrl);
        outputBlobUrl = URL.createObjectURL(blob);

        resultMeta.textContent = `输入：${humanSize(file.size)}，输出：${humanSize(blob.size)}，CRF：${crfSlider.value}`;
        resultBox.classList.remove("hidden");
        setStatus("转换完成，可下载");
        appendLog(`转换完成，输出大小：${humanSize(blob.size)}，总耗时 ${elapsed()}`);
        console.info("[webm-to-mp4] transcode-success", { outputSize: blob.size });
        setProgress(1);
        toggleDownload(true);
      } catch (error) {
        console.error(error);
        appendLog(`转换失败（${elapsed()}）：${error instanceof Error ? error.message : String(error)}`);
        setStatus("转换失败，请更换文件后重试");
      } finally {
        startBtn.disabled = false;
        transcodeStartedAt = 0;
      }
    });

    downloadBtn.addEventListener("click", () => {
      if (!outputBlobUrl) return;
      const a = document.createElement("a");
      a.href = outputBlobUrl;
      a.download = outputFileName || "output.mp4";
      document.body.appendChild(a);
      a.click();
      a.remove();
      appendLog(`下载已触发：${a.download}`);
      console.info("[webm-to-mp4] download-triggered", { name: a.download });
    });

    appendLog("工具已就绪，开始预加载 ffmpeg...");
    if ("requestIdleCallback" in window) {
      (window as Window & { requestIdleCallback: (cb: () => void) => number }).requestIdleCallback(() => warmupFfmpeg());
    } else {
      setTimeout(() => warmupFfmpeg(), 0);
    }
  </script>
</MainGridLayout>
