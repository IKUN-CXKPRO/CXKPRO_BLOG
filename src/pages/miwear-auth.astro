---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
---

<MainGridLayout title="小米运动健康AuthKey提取器" description="从安卓日志或iOS数据库中提取小米穿戴设备的 AuthKey。">
  <div class="onload-animation space-y-4 md:space-y-6 max-w-5xl mx-auto px-4 pb-12">
    
    <!-- 头部标题 -->
    <div class="card-base rounded-[var(--radius-large)] p-6 md:p-8 text-center shadow-lg">
      <div class="inline-flex items-center justify-center w-12 h-12 md:w-16 md:h-16 bg-[var(--primary)] rounded-2xl mb-4 shadow-lg shadow-[var(--primary)]/20">
        <Icon name="material-symbols:key" class="text-white text-2xl md:text-3xl" />
      </div>
      <h1 class="text-2xl md:text-3xl font-bold text-[var(--primary)] mb-2">AuthKey 提取器</h1>
      <p class="text-75 text-xs md:text-sm opacity-70">支持 Android 日志 ZIP 与 iOS manifest.sqlite 数据库提取</p>
      
      <div id="initStatus" class="mt-4 inline-flex items-center px-3 py-1 rounded-full bg-gray-100 dark:bg-white/5 text-[10px] md:text-[12px] font-medium text-gray-500">
        <div class="w-2 h-2 rounded-full bg-yellow-400 mr-2 animate-pulse" id="statusDot"></div>
        <span id="statusText">初始化核心引擎...</span>
      </div>
    </div>

    <!-- 教程卡片 -->
    <div class="card-base rounded-[var(--radius-large)] p-6 md:p-10 border border-[var(--line-divider)]">
        <h2 class="text-xl md:text-2xl font-bold text-90 flex items-center mb-6"><Icon name="material-symbols:android" class="mr-3 text-blue-400 text-2xl md:text-3xl" />安卓端提取方法</h2>
        <div class="max-w-3xl"><ol class="text-sm md:text-[16px] text-75 space-y-4 list-decimal ml-5"><li>小米运动健康 -> 我的 -> 关于 -> 连点Logo弹出日志</li><li>上传 Download/wearablelog/****.zip</li></ol></div>
    </div>

    <div class="card-base rounded-[var(--radius-large)] p-6 md:p-10 border border-[var(--line-divider)]">
        <h2 class="text-xl md:text-2xl font-bold text-90 flex items-center mb-6"><Icon name="material-symbols:phone-iphone" class="mr-3 text-blue-400 text-2xl md:text-3xl" />iOS端提取方法</h2>
        <div class="max-w-3xl"><ol class="text-sm md:text-[16px] text-75 space-y-4 list-decimal ml-5"><li>文件App -> 小米运动健康 -> VirtualDevice_registerList</li><li>上传 manifest.sqlite 文件</li></ol></div>
    </div>

    <!-- 解析设置面板 -->
    <div class="card-base rounded-[var(--radius-large)] p-6 md:p-10 border border-[var(--line-divider)]">
      <h2 class="text-xl md:text-2xl font-bold text-90 flex items-center mb-8">
        <Icon name="material-symbols:settings-suggest" class="mr-3 text-[var(--primary)] text-2xl md:text-3xl" />
        解析设置与高级选项
      </h2>
      <div class="space-y-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-1">
            <p class="text-sm md:text-[16px] font-bold text-90">提取模式选择</p>
            <p class="text-xs md:text-sm text-75 opacity-70">设定引擎对数据库或文本文件的解析优先级</p>
          </div>
          <div class="flex bg-gray-100 dark:bg-white/5 p-1.5 rounded-2xl w-full md:w-auto">
            <label class="flex-1 md:flex-none"><input type="radio" name="parseMode" value="smart" checked class="hidden peer"><div class="px-5 py-2.5 rounded-xl text-xs md:text-sm font-bold text-75 text-center cursor-pointer peer-checked:bg-[var(--primary)] peer-checked:text-white transition-all">智能模式</div></label>
            <label class="flex-1 md:flex-none"><input type="radio" name="parseMode" value="sql" class="hidden peer"><div class="px-5 py-2.5 rounded-xl text-xs md:text-sm font-bold text-75 text-center cursor-pointer peer-checked:bg-[var(--primary)] peer-checked:text-white transition-all">仅 SQL</div></label>
            <label class="flex-1 md:flex-none"><input type="radio" name="parseMode" value="scan" class="hidden peer"><div class="px-5 py-2.5 rounded-xl text-xs md:text-sm font-bold text-75 text-center cursor-pointer peer-checked:bg-[var(--primary)] peer-checked:text-white transition-all">硬扫描</div></label>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 border-t border-[var(--line-divider)] pt-6">
          <div class="flex gap-3">
            <Icon name="material-symbols:database-outline" class="text-[var(--primary)] text-xl shrink-0 mt-1" />
            <div class="space-y-1">
              <p class="text-sm font-bold text-90">SQL 读取模式（优先使用）</p>
              <p class="text-xs text-75 leading-relaxed">基于数据库 manifest 表。准确度最高，自动关联名称与 MAC 地址。</p>
            </div>
          </div>
          <div class="flex gap-3">
            <Icon name="material-symbols:search-check" class="text-[var(--primary)] text-xl shrink-0 mt-1" />
            <div class="space-y-1">
              <p class="text-sm font-bold text-90">硬扫描模式</p>
              <p class="text-xs text-75 leading-relaxed">特征匹配扫描。支持自动识别主流设备（手环/Watch S系列）。</p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="flex items-center justify-between p-5 bg-gray-100/50 dark:bg-white/5 rounded-2xl border border-[var(--line-divider)]">
            <div class="space-y-0.5"><p class="text-sm md:text-[16px] font-bold text-90">调试模式</p><p class="text-[10px] text-75 opacity-70">显示 Dump 与数据片段</p></div>
            <label class="relative inline-flex items-center cursor-pointer"><input type="checkbox" id="debugToggle" class="sr-only peer"><div class="w-11 h-6 bg-gray-200 rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[var(--primary)]"></div></label>
          </div>
          <div class="flex items-center justify-between p-5 bg-gray-100/50 dark:bg-white/5 rounded-2xl border border-[var(--line-divider)]">
            <div class="space-y-0.5"><p class="text-sm md:text-[16px] font-bold text-90">跨平台ZIP</p><p class="text-[10px] text-75 opacity-70">自动扫描嵌套 ZIP 包</p></div>
            <label class="relative inline-flex items-center cursor-pointer"><input type="checkbox" id="crossZipToggle" class="sr-only peer"><div class="w-11 h-6 bg-gray-200 rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[var(--primary)]"></div></label>
          </div>
          <div class="flex items-center justify-between p-5 bg-gray-100/50 dark:bg-white/5 rounded-2xl border border-[var(--line-divider)]">
            <div class="space-y-0.5"><p class="text-sm md:text-[16px] font-bold text-90">允许未知后缀</p><p class="text-[10px] text-75 opacity-70">允许上传任何后缀尝试扫描</p></div>
            <label class="relative inline-flex items-center cursor-pointer"><input type="checkbox" id="unsupportedToggle" checked class="sr-only peer"><div class="w-11 h-6 bg-gray-200 rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[var(--primary)]"></div></label>
          </div>
        </div>
      </div>
    </div>

    <!-- 上传区 (严格限制 accept 属性，解决安卓调用相机问题) -->
    <div class="card-base rounded-[var(--radius-large)] p-6 md:p-8 space-y-6">
      <input 
        type="file" 
        id="fileInput" 
        accept=".zip,.sqlite,.sqlite-wal,.db,.sqlitedb,application/zip,application/x-sqlite3,application/octet-stream" 
        class="hidden"
      >
      <div id="uploadArea" class="border-4 border-dashed border-[var(--line-divider)] rounded-3xl p-8 md:p-16 text-center cursor-pointer transition-all duration-500 hover:border-[var(--primary)] hover:bg-[var(--primary)]/[0.03] group">
        <div class="pointer-events-none space-y-4">
          <Icon name="material-symbols:cloud-upload" class="text-5xl md:text-6xl mx-auto text-gray-300 group-hover:text-[var(--primary)]" />
          <div><p class="text-lg md:text-2xl font-bold text-90">点击或拖拽文件上传</p><p class="text-xs md:text-sm text-gray-400 mt-2">支持 ZIP、SQLITE 及嵌套日志文件</p></div>
        </div>
      </div>
      <div id="progressBox" class="hidden space-y-2">
        <div class="flex justify-between text-xs font-bold text-75"><span id="progressLabel">准备解析...</span><span id="progressPercent">0%</span></div>
        <div class="w-full bg-gray-200 dark:bg-white/10 rounded-full h-2 md:h-3 overflow-hidden"><div id="progressBar" class="bg-[var(--primary)] h-full transition-all duration-300 w-0"></div></div>
      </div>
      <div class="flex justify-center"><button id="mobileBtn" type="button" class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 text-sm font-bold text-[var(--primary)] bg-[var(--primary)]/10 rounded-2xl border-2 border-[var(--primary)]/20 active:scale-95 transition-transform">从文件拾取器选择</button></div>
    </div>

    <!-- 结果显示 -->
    <div id="resultBox" class="hidden space-y-6">
      <div class="card-base rounded-[var(--radius-large)] p-6 border-l-8 border-[var(--primary)] shadow-lg">
        <h2 class="text-xl md:text-2xl font-bold text-90 mb-6 flex items-center"><Icon name="material-symbols:robot" class="mr-3 text-[var(--primary)] text-3xl" />提取结果</h2>
        <div id="autoResultContainer" class="grid grid-cols-1 gap-4"></div>
      </div>
      <div id="rawResultBox" class="hidden card-base rounded-[var(--radius-large)] p-6 md:p-8">
        <h2 class="text-lg md:text-xl font-bold text-90 mb-4 flex items-center text-gray-400"><Icon name="material-symbols:database" class="mr-3 text-2xl" />调试与原始输出</h2>
        <div id="debugOutput" class="mb-4 p-5 bg-red-50 dark:bg-red-900/10 text-red-500 rounded-2xl text-[10px] md:text-xs font-mono hidden whitespace-pre-wrap break-all"></div>
        <div id="rawResultContainer" class="space-y-4"></div>
      </div>
    </div>

    <!-- 终端日志控制台 -->
    <div class="card-base rounded-[var(--radius-large)] p-4 md:p-6 border border-[var(--line-divider)] shadow-2xl bg-[#0a0a0a]">
        <div class="flex items-center justify-between mb-4 border-b border-white/5 pb-2">
            <div class="flex items-center gap-2">
                <Icon name="material-symbols:terminal" class="text-[#4ade80]" />
                <h2 class="text-xs font-bold text-white/80 uppercase tracking-widest font-mono">Operation Flow Console v2.0</h2>
            </div>
            <button id="clearLogBtn" class="text-[9px] px-3 py-1 bg-white/5 text-white/40 border border-white/10 rounded hover:bg-red-500/20 hover:text-red-400 transition-all font-mono">FLUSH_LOGS</button>
        </div>
        <div id="systemLogConsole" class="bg-[#050505] text-[#4ade80] rounded-lg p-4 h-80 overflow-y-auto font-mono text-[13px] md:text-[14px] space-y-2 scroll-smooth border border-white/5">
            <div class="flex gap-2">
                <span class="text-white/20 shrink-0 font-mono text-[11px] md:text-[12px]">[00:00:00.000]</span>
                <span class="bg-green-500/10 text-[#4ade80] px-1.5 rounded text-[11px] font-bold">虚拟机</span>
                <span class="opacity-40 italic">等待操作指令...</span>
            </div>
        </div>
    </div>
  </div>

  <style is:global>
    .drag-over { border-color: var(--primary) !important; background-color: var(--card-bg) !important; }
    .toast-msg { position: fixed; top: 40px; left: 50%; transform: translateX(-50%); padding: 10px 24px; background: #2d2d2d; color: #ffffff; border-radius: 50px; z-index: 9999; font-size: 14px; shadow: 0 8px 24px rgba(0,0,0,0.2); animation: toastIn 0.4s forwards; }
    @keyframes toastIn { from { transform: translate(-50%, -40px); opacity: 0; } to { transform: translate(-50%, 0); opacity: 1; } }
    .debug-card { background: var(--card-bg); border: 1px solid var(--line-divider); border-radius: 1.25rem; padding: 1.25rem; }
    .debug-card pre { font-family: monospace; font-size: 0.75rem; white-space: pre-wrap; word-break: break-all; opacity: 0.8; line-height: 1.5; }
    .highlight-key { background-color: var(--primary); color: white !important; padding: 1px 4px; border-radius: 4px; font-weight: bold; }
    #systemLogConsole::-webkit-scrollbar { width: 4px; }
    #systemLogConsole::-webkit-scrollbar-thumb { background: rgba(74,222,128,0.2); border-radius: 10px; }
  </style>

  <script>
    declare global { interface Window { copyToClipboard: (text: string) => void; initSqlJs: any; } }
    interface AuthResult { name: string; key: string; mac?: string; platform?: string; isSql?: boolean; }
    interface DebugInfo { offset: number; content: string; }

    let JSZip: any = null;
    let SQL: any = null;

    const setCookie = (name: string, value: string) => { document.cookie = `${name}=${value};path=/;max-age=31536000`; };
    const getCookie = (name: string) => {
      const value = `; ${document.cookie}`;
      const parts = value.split(`; ${name}=`);
      if (parts.length === 2) return parts.pop()?.split(';').shift();
      return null;
    };

    const terminal = (msg: string, tag: string = 'BROWSER', type: 'text' | 'device' = 'text') => {
        const consoleEl = document.getElementById('systemLogConsole');
        if (!consoleEl) return;
        const entry = document.createElement('div');
        entry.className = "flex gap-2 items-start animate-in fade-in slide-in-from-left-1 duration-300";
        const now = new Date();
        const ms = now.getMilliseconds().toString().padStart(3, '0');
        const time = `${now.toLocaleTimeString('en-GB', { hour12: false })}.${ms}`;
        
        const tagMap: Record<string, string> = {
            WASM: '虚拟机', FS: '文件流', BROWSER: '框架层', CONFIG: '持久化',
            NETWORK: '网络层', INIT: '初始化', SUCCESS: '命中', ERROR: '异常', DEVICE: '匹配'
        };

        if (type === 'device') {
            entry.innerHTML = `<span class="text-white/20 shrink-0 font-mono text-[11px] md:text-[12px]">[${time}]</span><span class="bg-cyan-500/20 text-[#22d3ee] shrink-0 px-1.5 rounded text-[11px] font-bold">设备匹配</span><span class="text-[#22d3ee] font-bold">${msg}</span>`;
        } else {
            entry.innerHTML = `<span class="text-white/20 shrink-0 font-mono text-[11px] md:text-[12px]">[${time}]</span><span class="bg-white/10 text-white/40 shrink-0 px-1.5 rounded text-[11px] font-bold uppercase">${tagMap[tag] || tag}</span><span class="break-all ${tag === 'ERROR' ? 'text-red-400' : tag === 'SUCCESS' ? 'text-green-300' : 'text-white/60'}">${msg}</span>`;
        }
        consoleEl.prepend(entry);
    };

    const hookConsole = () => {
        const _log = console.log;
        const _warn = console.warn;
        const _err = console.error;
        const _info = console.info;
        console.log = (...args) => { _log(...args); terminal(args.join(' '), 'BROWSER'); };
        console.info = (...args) => { _info(...args); terminal(args.join(' '), 'INIT'); };
        console.warn = (...args) => { _warn(...args); terminal(args.join(' '), 'NETWORK'); };
        console.error = (...args) => { _err(...args); terminal(args.join(' '), 'ERROR'); };
    };

    async function calculateFileHash(buffer: ArrayBuffer) {
        terminal("开始计算二进制流 SHA-256 指纹...", "FS");
        const hashBuffer = await crypto.subtle.digest('SHA-256', buffer);
        return Array.from(new Uint8Array(hashBuffer)).map(b => b.toString(16).padStart(2, '0')).join('');
    }

    const showToast = (msg: string) => {
      const old = document.querySelector('.toast-msg');
      if (old) old.remove();
      const el = document.createElement('div');
      el.className = 'toast-msg'; el.innerText = msg;
      document.body.appendChild(el);
      setTimeout(() => el.remove(), 2500);
    };

    const DEVICE_PATTERNS = [
      { name: "小米手环9 Pro", label: "小米手环9 Pro" }, { name: "小米手环9", label: "小米手环9" },
      { name: "小米手环10 Pro", label: "小米手环10 Pro" }, { name: "小米手环10", label: "小米手环10" },
      { name: "Xiaomi Watch S4 41mm", label: "Xiaomi Watch S4 41mm" }, { name: "Xiaomi Watch S4 eSIM", label: "Xiaomi Watch S4 eSIM" },
      { name: "Xiaomi Watch S4", label: "Xiaomi Watch S4" }, { name: "Xiaomi Watch S3 eSIM", label: "Xiaomi Watch S3 eSIM" },
      { name: "Xiaomi Watch S3", label: "Xiaomi Watch S3" }, { name: "Xiaomi Watch S5 46mm eSIM", label: "Xiaomi Watch S5 46mm eSIM" },
      { name: "Xiaomi Watch S5 46mm", label: "Xiaomi Watch S5 46mm" }, { name: "REDMI Watch 5 eSIM", label: "REDMI Watch 5 eSIM" },
      { name: "REDMI Watch 5", label: "REDMI Watch 5" }, { name: "REDMI Watch 6", label: "REDMI Watch 6" }
    ];

    async function initEngines() {
      hookConsole();
      terminal("拉取外部资源模块中...", "NETWORK");
      try {
        const [jszipModule] = await Promise.all([
          import('jszip'),
          new Promise((res, rej) => {
            const s = document.createElement('script');
            s.src = 'https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.8.0/sql-wasm.js';
            s.onload = res; s.onerror = rej; document.head.appendChild(s);
          })
        ]);
        JSZip = jszipModule.default;
        terminal("JSZip 处理库加载完成", "FS");
        SQL = await (window as any).initSqlJs({ locateFile: (f: string) => `https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.8.0/${f}` });
        terminal("SQL-WASM 已初始化", "WASM");
        document.getElementById('statusText')!.innerText = "引擎就绪 (WASM已缓存)";
        document.getElementById('statusDot')!.className = "w-2 h-2 rounded-full bg-green-500 mr-2";
      } catch (err: any) { terminal(`核心异常: ${err.message}`, "ERROR"); }
    }

    document.addEventListener('DOMContentLoaded', () => {
      initEngines();
      const fileInput = document.getElementById('fileInput') as HTMLInputElement;
      const uploadArea = document.getElementById('uploadArea');
      const mobileBtn = document.getElementById('mobileBtn');
      const debugToggle = document.getElementById('debugToggle') as HTMLInputElement;
      const crossZipToggle = document.getElementById('crossZipToggle') as HTMLInputElement;
      const unsupportedToggle = document.getElementById('unsupportedToggle') as HTMLInputElement;
      const parseModeRadios = document.getElementsByName('parseMode') as NodeListOf<HTMLInputElement>;
      const autoResultContainer = document.getElementById('autoResultContainer');
      const rawResultContainer = document.getElementById('rawResultContainer');
      const debugOutput = document.getElementById('debugOutput');
      const rawResultBox = document.getElementById('rawResultBox');

      const cDebug = getCookie('debugMode') === 'true';
      const cCross = getCookie('crossZip') === 'true';
      const cUnsup = getCookie('allowUnsupported') !== 'false';
      const cMode = getCookie('parseMode') || 'smart';

      debugToggle.checked = cDebug;
      crossZipToggle.checked = cCross;
      unsupportedToggle.checked = cUnsup;
      parseModeRadios.forEach(r => { if(r.value === cMode) r.checked = true; });

      terminal(`载入配置：调试(${cDebug}), 跨平台(${cCross}), 模式(${cMode})`, "CONFIG");

      const handleToggleRefresh = (el: HTMLInputElement, cookieName: string, label: string) => {
        el.addEventListener('change', () => {
            setCookie(cookieName, String(el.checked));
            terminal(`配置变更：[${label}] 已同步。重载中...`, "CONFIG");
            showToast(`✓ ${label}已变更，重载中...`);
            setTimeout(() => location.reload(), 800);
        });
      };
      handleToggleRefresh(debugToggle, 'debugMode', '调试模式');
      handleToggleRefresh(crossZipToggle, 'crossZip', '跨平台ZIP');
      handleToggleRefresh(unsupportedToggle, 'allowUnsupported', '读取策略');

      parseModeRadios.forEach(r => r.addEventListener('change', () => { 
          if(r.checked){ 
              setCookie('parseMode', r.value); 
              terminal(`解析策略切换为：${r.value}`, "CONFIG");
              showToast(`✓ 模式已切换`); 
          } 
      }));

      window.copyToClipboard = async (t) => {
        try { await navigator.clipboard.writeText(t); } 
        catch { const ta = document.createElement('textarea'); ta.value = t; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); document.body.removeChild(ta); }
        terminal(`成功复制密钥 ${t.substring(0,8)}...`, "SUCCESS");
        showToast('✓ 复制成功');
      };

      const parseAndroidFromContent = (content: string): AuthResult[] => {
        const results: AuthResult[] = []; const seenTokens = new Set<string>();
        const tokenGlobalRegex = /"token"\s*[:=]\s*"([a-fA-F0-9]{32})"/gi;
        let match;
        while ((match = tokenGlobalRegex.exec(content)) !== null) {
            const token = match[1];
            if (seenTokens.has(token)) continue;
            const pos = match.index;
            const context = content.substring(Math.max(0, pos - 2000), Math.min(content.length, pos + 500));
            const nameSearchRegex = /"(product[Nn]ame|device[Nn]ame|model[Nn]ame|name)"\s*[:=]\s*"([^"]+)"/gi;
            let deviceName = ""; let nameMatch;
            while ((nameMatch = nameSearchRegex.exec(context)) !== null) { deviceName = nameMatch[2]; }
            const macMatch = context.match(/([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}/);
            if (!deviceName || deviceName.toLowerCase() === "null") {
                for (const p of DEVICE_PATTERNS) if (context.includes(p.name)) { deviceName = p.label; break; }
            }
            results.push({ name: deviceName || "Android设备", key: token, mac: macMatch ? macMatch[0] : undefined, platform: 'Android' });
            seenTokens.add(token);
        }
        return results;
      };

      const processSQL = (u8: Uint8Array, isWal: boolean = false): {results: AuthResult[], log: string} => {
          let results: AuthResult[] = []; let log = "";
          try {
              const db = new SQL.Database(u8);
              const tables: string[] = [];
              const tableStmt = db.prepare("SELECT name FROM sqlite_master WHERE type='table'");
              while(tableStmt.step()) tables.push(tableStmt.get()[0] as string); tableStmt.free();
              if (tables.includes('manifest')) {
                  const stmt = db.prepare("SELECT inline_data FROM manifest WHERE inline_data IS NOT NULL");
                  while (stmt.step()) {
                      const blob = stmt.get()[0] as Uint8Array;
                      if (blob) {
                          const rawStr = new TextDecoder('latin1').decode(blob);
                          const keyM = rawStr.match(/[a-fA-F0-9]{32}/);
                          const macM = rawStr.match(/([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}/);
                          let nm = "iOS设备"; for (const p of DEVICE_PATTERNS) if (rawStr.includes(p.name)) { nm = p.label; break; }
                          if (keyM) {
                              terminal(`${nm} | MAC: ${macM ? macM[0] : '无'}`, "SUCCESS", "device");
                              results.push({ name: nm, key: keyM[0], mac: macM ? macM[0] : undefined, platform: isWal ? 'SQLite-wal' : 'iOS (SQL模式)', isSql: true });
                          }
                      }
                  }
                  stmt.free();
              }
              db.close();
          } catch(e: any) { terminal(`SQL异常: ${e.message}`, "ERROR"); }
          return { results, log };
      };

      const processScan = (u8: Uint8Array, label: string = '硬扫描'): {results: AuthResult[], debugs: DebugInfo[]} => {
          const results: AuthResult[] = []; const debugs: DebugInfo[] = []; const seen = new Set<string>();
          const raw = new TextDecoder('latin1').decode(u8);
          const anchors = ["encrypt_key", "auth_key", "peripheral_id", "token"];
          anchors.forEach(anchor => {
            let pos = raw.indexOf(anchor);
            while (pos !== -1) {
              const win = raw.substring(Math.max(0, pos - 500), Math.min(raw.length, pos + 500));
              const hexM = win.match(/[a-fA-F0-9]{32}/g);
              if (hexM) hexM.forEach(k => {
                if (!seen.has(k)) {
                  let nm = "扫描记录"; for (const p of DEVICE_PATTERNS) if (win.includes(p.name)) { nm = p.label; break; }
                  results.push({ name: nm, key: k, platform: label, isSql: false });
                  seen.add(k);
                }
              });
              debugs.push({ offset: pos, content: win });
              pos = raw.indexOf(anchor, pos + 1);
            }
          });
          return { results, debugs };
      };

      const handleFile = async (f: File) => {
        if (!f || !JSZip || !SQL) return;
        terminal(`导入文件：[${f.name}]`, "INIT");
        const reader = new FileReader();
        reader.onload = async () => {
          try {
            const buf = new Uint8Array(reader.result as ArrayBuffer);
            const hash = await calculateFileHash(buf.buffer);
            terminal(`SHA256指纹: [${hash.substring(0,32)}...]`, "FS");
            let fRes: AuthResult[] = []; let fDbg: DebugInfo[] = []; let fLog = "";
            const name = f.name.toLowerCase();
            
            if (name.endsWith('.zip')) {
                const zip = await JSZip.loadAsync(buf.buffer);
                const logKey = Object.keys(zip.files).find(f => f.toLowerCase().includes('main.log') || f.toLowerCase().endsWith('.log'));
                if (logKey) {
                    const content = await zip.file(logKey)!.async('text');
                    fRes = parseAndroidFromContent(content);
                }
            } else if (name.endsWith('.sqlite-wal')) {
                const sR = processSQL(buf, true); fRes = sR.results; fLog = sR.log;
                const sc = processScan(buf, 'SQLite-wal'); fRes.push(...sc.results); fDbg = sc.debugs;
            } else {
                const sR = processSQL(buf); fRes = sR.results; fLog = sR.log;
                const sc = processScan(buf); fRes.push(...sc.results); fDbg = sc.debugs;
            }

            renderUI(fRes, fDbg, fLog);
          } catch (e: any) { terminal(`崩溃: ${e.message}`, "ERROR"); }
        };
        reader.readAsArrayBuffer(f);
      };

      const renderUI = (list: AuthResult[], debugs: DebugInfo[], dLog: string) => {
        if (!autoResultContainer || !rawResultContainer || !rawResultBox || !debugOutput) return;
        
        // 分组结果
        const sqlItems = list.filter(i => i.isSql);
        const scanItems = list.filter(i => !i.isSql);
        const androidItems = list.filter(i => i.platform === 'Android');
        
        let html = "";
        
        // 渲染逻辑
        const renderBlock = (items: AuthResult[], isPriority = false) => {
            return items.map(i => `
                <div class="flex flex-col md:flex-row justify-between items-center gap-4 bg-[var(--primary)]/[0.04] p-5 rounded-2xl border border-[var(--primary)]/10">
                  <div class="w-full text-center md:text-left overflow-hidden">
                    <div class="flex items-center justify-center md:justify-start gap-2 mb-1">
                        <span class="text-[9px] px-2 py-0.5 rounded-full bg-[var(--primary)]/10 text-[var(--primary)] font-black uppercase">${i.platform}</span>
                        <div class="text-sm md:text-lg font-black text-90 opacity-90">${i.name}</div>
                        ${isPriority ? '<span class="text-[9px] px-2 py-0.5 rounded-full bg-green-500/20 text-green-500 font-bold">优先尝试</span>' : ''}
                    </div>
                    ${i.mac ? `<div class="text-[10px] md:text-xs font-bold text-75 opacity-60 mb-2 uppercase tracking-wider">${i.mac}</div>` : ''}
                    <div class="font-mono text-sm md:text-xl font-black break-all text-90 select-all leading-tight">${i.key}</div>
                  </div>
                  <button onclick="copyToClipboard('${i.key}')" class="shrink-0 w-full md:w-auto px-6 py-3 bg-[var(--primary)] text-white rounded-xl text-sm font-bold active:scale-95 shadow-md">复制</button>
                </div>
            `).join('');
        };

        html += renderBlock(sqlItems, true);
        if (sqlItems.length > 0 && (scanItems.length > 0 || androidItems.length > 0)) {
            html += '<div class="my-8"></div>'; // 空 2 格
        }
        html += renderBlock(androidItems);
        html += renderBlock(scanItems);

        autoResultContainer.innerHTML = html || '<div class="p-8 text-center opacity-40 italic">未发现结果</div>';
        
        debugOutput.innerText = dLog; debugOutput.classList.toggle('hidden', !dLog);
        rawResultContainer.innerHTML = debugs.map(d => `<div class="debug-card"><div class="text-[10px] opacity-30 mb-1">OFFSET: ${d.offset}</div><pre>${d.content.replace(/[a-fA-F0-9]{32}/g, m => `<span class="highlight-key">${m}</span>`)}</pre></div>`).join('');
        document.getElementById('resultBox')?.classList.remove('hidden');
        rawResultBox.classList.toggle('hidden', !debugToggle.checked);
        document.getElementById('resultBox')?.scrollIntoView({ behavior: 'smooth' });
      };

      uploadArea?.addEventListener('click', () => { terminal("点击触发：请求文件选择器", "INIT"); fileInput.click(); });
      mobileBtn?.addEventListener('click', () => { terminal("按钮触发：请求文件拾取", "INIT"); fileInput.click(); });
      fileInput.onchange = (e: any) => { if (e.target.files.length > 0) handleFile(e.target.files[0]); };
      uploadArea?.addEventListener('dragover', (e) => { e.preventDefault(); uploadArea.classList.add('drag-over'); });
      uploadArea?.addEventListener('dragleave', () => uploadArea.classList.remove('drag-over'));
      uploadArea?.addEventListener('drop', (e: any) => { 
          e.preventDefault(); uploadArea.classList.remove('drag-over'); 
          if (e.dataTransfer?.files.length > 0) handleFile(e.dataTransfer.files[0]); 
      });
    });
  </script>
</MainGridLayout>