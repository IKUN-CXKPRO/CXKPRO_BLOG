---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
---

<MainGridLayout title="小米运动健康AuthKey提取器" description="从安卓日志或iOS数据库中提取小米穿戴设备的 AuthKey。">
  <div class="onload-animation space-y-6 max-w-5xl mx-auto px-4 pb-12">
    
    <!-- 头部标题 -->
    <div class="card-base rounded-[var(--radius-large)] p-8 text-center shadow-lg">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-[var(--primary)] rounded-2xl mb-4 shadow-lg shadow-[var(--primary)]/20">
        <Icon name="material-symbols:key" class="text-white text-3xl" />
      </div>
      <h1 class="text-3xl font-bold text-[var(--primary)] mb-2">AuthKey 提取器</h1>
      <p class="text-75 text-sm opacity-70">支持 Android 日志 ZIP 与 iOS manifest.sqlite 数据库提取</p>
    </div>

    <!-- 安卓端提取方法卡片 -->
    <div class="card-base rounded-[var(--radius-large)] p-10 md:p-12 border border-[var(--line-divider)]">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-bold text-90 flex items-center justify-center">
          <Icon name="material-symbols:android" class="mr-3 text-blue-400 text-3xl" />
          安卓端提取方法
        </h2>
      </div>
      <div class="max-w-2xl mx-auto">
        <ol class="text-[17px] text-75 space-y-5 leading-relaxed list-decimal list-outside ml-6">
          <li>打开小米运动健康 APP</li>
          <li>点击右下角"我的" -> 滑动到最下方选择"关于"</li>
          <li>连续点击关于页面上方的logo，直到弹出日志保存提示</li>
          <li>在文件管理器中找到 <code class="bg-[var(--line-divider)] px-2 py-1 rounded font-mono text-sm mx-1">Download/wearablelog/****.zip</code></li>
          <li>上传该ZIP文件</li>
          <li>上传文件后不显示的话，多刷新几下然后重新上传即可</li>
        </ol>
      </div>
    </div>

    <!-- iOS端提取方法卡片 -->
    <div class="card-base rounded-[var(--radius-large)] p-10 md:p-12 border border-[var(--line-divider)]">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-bold text-90 flex items-center justify-center">
          <Icon name="material-symbols:phone-iphone" class="mr-3 text-blue-400 text-3xl" />
          iOS端提取方法
        </h2>
      </div>
      <div class="max-w-2xl mx-auto">
        <ol class="text-[17px] text-75 space-y-5 leading-relaxed list-decimal list-outside ml-6">
          <li>打开系统自带的"文件"app，浏览我的iPhone，找到小米运动健康文件夹，按路径找到文件 <code class="bg-[var(--line-divider)] px-1 py-0.5 rounded font-mono text-sm">\MHWCahe\6284670\VirtualDevice_registerList\manifest.sqlite</code></li>
          <li>上传sqlite文件</li>
          <li>自行寻找：在encrypt_key找到peripheral_id，后面的16位字符就是AuthKey</li>
          <li>上传文件后不显示的话，多刷新几下然后重新上传即可</li>
        </ol>
      </div>
    </div>

    <!-- 上传区域 -->
    <div class="card-base rounded-[var(--radius-large)] p-8">
      <input type="file" id="fileInput" accept=".zip,.sqlite,.db,.sqlitedb,.sqlite-wal,application/x-sqlite3,application/octet-stream,*" class="hidden">
      
      <div 
        id="uploadArea"
        class="border-4 border-dashed border-[var(--line-divider)] rounded-3xl p-16 text-center cursor-pointer transition-all duration-500 hover:border-[var(--primary)] hover:bg-[var(--primary)]/[0.03] group"
      >
        <div class="pointer-events-none space-y-4">
          <Icon name="material-symbols:cloud-upload" class="text-6xl mx-auto text-gray-300 group-hover:text-[var(--primary)] transition-colors" />
          <div>
            <p class="text-2xl font-bold text-90">点击此处或拖拽文件上传</p>
            <p class="text-sm text-gray-400 mt-2">支持 .zip (Android) 或 .sqlite (iOS)</p>
          </div>
        </div>
      </div>

      <!-- 移动端 100% 触发按钮 -->
      <div class="mt-6 flex justify-center">
        <div class="relative overflow-hidden inline-block w-full sm:w-auto">
          <button type="button" class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-base font-bold text-[var(--primary)] bg-[var(--primary)]/10 rounded-2xl border-2 border-[var(--primary)]/20 active:scale-95">
            <Icon name="material-symbols:touch-app" class="mr-2 text-xl" />
            移动端无法选择文件点我
          </button>
          <input
            id="fallbackFileInput"
            type="file"
            accept=".zip,.sqlite,.db,.sqlitedb,.sqlite-wal,application/x-sqlite3,application/octet-stream,*"
            class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
          >
        </div>
      </div>
    </div>

    <!-- 结果区域 -->
    <div id="resultBox" class="hidden space-y-8">
      <div class="card-base rounded-[var(--radius-large)] p-8 border-l-8 border-[var(--primary)] shadow-lg">
        <h2 class="text-2xl font-bold text-90 mb-6 flex items-center">
          <Icon name="material-symbols:robot" class="mr-3 text-[var(--primary)] text-3xl" />
          智能提取结果
        </h2>
        <div id="autoResultContainer" class="grid grid-cols-1 gap-4"></div>
      </div>

      <div id="rawResultBox" class="hidden card-base rounded-[var(--radius-large)] p-8">
        <h2 class="text-2xl font-bold text-90 mb-6 flex items-center">
          <Icon name="material-symbols:database" class="mr-3 text-gray-400 text-3xl" />
          原始数据检测 (Binary Context)
        </h2>
        <div id="rawResultContainer" class="space-y-6"></div>
      </div>
    </div>

  </div>

  <style is:global>
    .drag-over { border-color: var(--primary) !important; background-color: var(--card-bg) !important; }
    
    .copy-msg { 
      position: fixed; top: 40px; left: 50%; transform: translateX(-50%);
      padding: 10px 24px; background: #2d2d2d; color: #ffffff; 
      border-radius: 50px; z-index: 9999; font-size: 14px; font-weight: 500;
      box-shadow: 0 8px 24px rgba(0,0,0,0.2); pointer-events: none;
      animation: toastIn 0.4s cubic-bezier(0.18, 0.89, 0.32, 1.28) forwards;
    }
    
    @keyframes toastIn { from { transform: translate(-50%, -40px); opacity: 0; } to { transform: translate(-50%, 0); opacity: 1; } }

    .debug-card { background: var(--card-bg); border: 1px solid var(--line-divider); border-radius: 1.25rem; padding: 1.5rem; }
    .debug-card pre { 
      font-family: monospace;
      font-size: 0.8rem; white-space: pre-wrap; word-break: break-all;
      color: var(--text-color); opacity: 0.9;
    }
    .highlight-key { background-color: var(--primary); color: white !important; padding: 1px 4px; border-radius: 4px; font-weight: bold; }
  </style>

  <script>
    const JSZip = (await import('jszip')).default;

    document.addEventListener('DOMContentLoaded', () => {
      const fileInput = document.getElementById('fileInput');
      const fallbackFileInput = document.getElementById('fallbackFileInput');
      const uploadArea = document.getElementById('uploadArea');
      const resultBox = document.getElementById('resultBox');
      const autoResultContainer = document.getElementById('autoResultContainer');
      const rawResultContainer = document.getElementById('rawResultContainer');
      const rawResultBox = document.getElementById('rawResultBox');

      window.copyToClipboard = (text) => {
        const ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        
        const old = document.querySelector('.copy-msg');
        if (old) old.remove();
        const el = document.createElement('div');
        el.className = 'copy-msg';
        el.innerHTML = `✓ 密钥复制成功`;
        document.body.appendChild(el);
        setTimeout(() => el.remove(), 2000);
      };

      // --- Android 逻辑 ---
      const parseAndroid = async (file) => {
        const arrayBuffer = await file.arrayBuffer();
        const zip = await JSZip.loadAsync(arrayBuffer);
        let selectedLogFile = null;
        for (const fileName in zip.files) {
          if (fileName.toLowerCase().includes('xiaomifit.main.log')) {
            selectedLogFile = fileName;
            break;
          }
        }
        if (!selectedLogFile) {
          selectedLogFile = Object.keys(zip.files).find(f => f.toLowerCase().endsWith('.log') && !zip.files[f].dir);
        }
        if (!selectedLogFile) throw new Error("ZIP 中未找到日志文件");
        const content = await zip.file(selectedLogFile).async('text');
        const results = [];
        const seen = new Set();
        const jsonLineRegex = /({[^{}]*"productName"[^{}]*"token"[^{}]*})|({[^{}]*"token"[^{}]*"productName"[^{}]*})/g;
        let match;
        while ((match = jsonLineRegex.exec(content)) !== null) {
          try {
            const jsonObj = JSON.parse(match[0]);
            if (jsonObj.token && !seen.has(jsonObj.token)) {
              results.push({ name: jsonObj.productName || "Android设备", key: jsonObj.token });
              seen.add(jsonObj.token);
            }
          } catch (e) {}
        }
        if (results.length === 0) {
          const productNameRegex = /["']?productName["']?\s*[=:]\s*["']([^"']+)["']/g;
          const tokenRegex = /["']?token["']?\s*[=:]\s*["']([^"']+)["']/g;
          const productNames = [], tokens = [];
          let m;
          while ((m = productNameRegex.exec(content)) !== null) productNames.push(m[1]);
          while ((m = tokenRegex.exec(content)) !== null) tokens.push(m[1]);
          for (let i = 0; i < Math.max(productNames.length, tokens.length); i++) {
            if (tokens[i] && !seen.has(tokens[i])) {
              results.push({ name: productNames[i] || "Android设备", key: tokens[i] });
              seen.add(tokens[i]);
            }
          }
        }
        return results;
      };

      // --- iOS 逻辑 ---
      const processIOS = async (file) => {
        const buffer = await file.arrayBuffer();
        const uint8 = new Uint8Array(buffer);
        let rawStr = "";
        for (let i = 0; i < uint8.length; i++) {
          rawStr += (uint8[i] >= 32 && uint8[i] <= 126) ? String.fromCharCode(uint8[i]) : ".";
        }
        const autoResults = [];
        const debugInfos = [];
        const seen = new Set();
        const anchor = "encrypt_key";
        let pos = rawStr.indexOf(anchor);
        while (pos !== -1) {
          const windowText = rawStr.substring(Math.max(0, pos - 400), Math.min(rawStr.length, pos + 800));
          const hexMatches = windowText.match(/[a-fA-F0-9]{32}/g);
          if (hexMatches) {
            hexMatches.forEach(key => {
              if (!seen.has(key)) {
                autoResults.push({ name: "iOS设备", key: key });
                seen.add(key);
              }
            });
          }
          debugInfos.push({ offset: pos, content: windowText });
          pos = rawStr.indexOf(anchor, pos + 1);
        }
        return { autoResults, debugInfos };
      };

      const handleFile = async (file) => {
        if (!file) return;
        resultBox.classList.remove('hidden');
        autoResultContainer.innerHTML = '<div class="p-8 text-center animate-pulse">正在解析文件...</div>';
        rawResultBox.classList.add('hidden');
        try {
          if (file.name.toLowerCase().endsWith('.zip')) {
            const list = await parseAndroid(file);
            renderAuto(list);
          } else {
            const { autoResults, debugInfos } = await processIOS(file);
            renderAuto(autoResults);
            renderRaw(debugInfos);
            rawResultBox.classList.remove('hidden');
          }
          resultBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } catch (e) {
          autoResultContainer.innerHTML = `<div class="p-6 text-red-500">解析失败: ${e.message}</div>`;
        }
      };

      const renderAuto = (list) => {
        if (list.length === 0) {
          autoResultContainer.innerHTML = '<div class="p-8 text-center opacity-40 italic">未找到记录</div>';
          return;
        }
        autoResultContainer.innerHTML = list.map(item => `
          <div class="flex flex-col md:flex-row justify-between items-center gap-6 bg-[var(--primary)]/[0.04] p-6 rounded-2xl border border-[var(--primary)]/10">
            <div class="w-full text-center md:text-left">
              <div class="text-[10px] font-black text-[var(--primary)] uppercase mb-2 tracking-widest opacity-80">${item.name}</div>
              <div class="font-mono text-xl font-black break-all text-90 select-all leading-tight">${item.key}</div>
            </div>
            <button onclick="copyToClipboard('${item.key}')" class="shrink-0 w-full md:w-auto px-10 py-4 bg-[var(--primary)] text-white rounded-xl text-sm font-black shadow-lg shadow-[var(--primary)]/20 active:scale-95 transition-all">复制密钥</button>
          </div>
        `).join('');
      };

      const renderRaw = (debugs) => {
        rawResultContainer.innerHTML = debugs.map(d => `
          <div class="debug-card mb-4">
            <div class="text-[10px] opacity-30 mb-3 font-mono">OFFSET: ${d.offset}</div>
            <pre>${d.content.replace(/[a-fA-F0-9]{32}/g, m => `<span class="highlight-key">${m}</span>`)}</pre>
          </div>
        `).join('');
      };

      uploadArea.onclick = () => fileInput.click();
      fileInput.onchange = (e) => handleFile(e.target.files[0]);
      fallbackFileInput.onchange = (e) => handleFile(e.target.files[0]);
      uploadArea.ondragover = (e) => { e.preventDefault(); uploadArea.classList.add('drag-over'); };
      uploadArea.ondragleave = () => uploadArea.classList.remove('drag-over');
      uploadArea.ondrop = (e) => { e.preventDefault(); uploadArea.classList.remove('drag-over'); handleFile(e.dataTransfer.files[0]); };
    });
  </script>
</MainGridLayout>